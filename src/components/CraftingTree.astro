  const finalTitle = document.getElementById('treeFinalTitle');
  const finalDamage = document.getElementById('treeFinalDamage');
  const finalDesc = document.getElementById('treeFinalDesc');
  const tableFee = document.getElementById('treeTableFee');

  const sumTotalFee = document.getElementById('treeSummaryTotalFee');
  const sumSteel = document.getElementById('treeSummarySteel');
  const sumWood = document.getElementById('treeSummaryWood');
  const sumGold = document.getElementById('treeSummaryGold');
  const sumCement = document.getElementById('treeSummaryCement');
  const sumCrystal = document.getElementById('treeSummaryCrystal');

  function renderTree(weaponId: string) {
    const data = weaponsData[weaponId];
    if (!data) return;

    if (activeName) activeName.textContent = data.name;
    if (activeBadge) {
      activeBadge.textContent = data.badge;
      activeBadge.className = `rounded px-2 py-0.5 text-[10px] font-bold ${data.badgeClass}`;
    }

    if (qtyCement) qtyCement.textContent = data.materials.cement;
    if (qtyWood) qtyWood.textContent = data.materials.wood;
    if (qtySteel) qtySteel.textContent = data.materials.steel;
    if (qtyGold) qtyGold.textContent = data.materials.gold;
    if (qtyCrystal) qtyCrystal.textContent = data.materials.crystal;

    if (qtyBox) qtyBox.textContent = data.boxQty;
    if (boxFee) boxFee.textContent = data.boxFee;

    if (coreCard) coreCard.className = `tree-node p-4 rounded-2xl border ${data.coreBorder} relative`;
    if (coreIcon) coreIcon.src = data.coreIcon;
    if (coreTitle) coreTitle.textContent = data.coreName;
    if (coreType) coreType.textContent = data.coreType;
    if (coreQty) coreQty.textContent = data.coreQty;

    if (bpIcon) bpIcon.src = data.blueprintIcon;
    if (bpName) bpName.textContent = data.blueprintName;

    if (baseRow) {
      if (data.hasBase) {
        baseRow.style.display = 'flex';
        if (baseIcon) {
          baseIcon.src = data.baseWeaponIcon;
          baseIcon.style.display = 'inline-block';
        }
        if (baseName) baseName.textContent = data.baseWeapon;
      } else {
        baseRow.style.display = 'flex';
        if (baseIcon) baseIcon.style.display = 'none';
        if (baseName) baseName.textContent = 'ไม่ต้องใช้เบสอาวุธ';
      }
    }

    if (finalIcon) finalIcon.src = data.icon;
    if (finalTitle) finalTitle.textContent = data.name;
    if (finalDamage) finalDamage.textContent = `ความแรง: ${data.damage} ดาเมจ`;
    if (finalDesc) finalDesc.textContent = data.desc;
    if (tableFee) tableFee.textContent = data.tableFee;

    if (sumTotalFee) sumTotalFee.textContent = data.totalFee;
    if (sumSteel) sumSteel.textContent = data.materials.steel.replace('x', '');
    if (sumWood) sumWood.textContent = data.materials.wood.replace('x', '');
    if (sumGold) sumGold.textContent = data.materials.gold.replace('x', '');
    if (sumCement) sumCement.textContent = data.materials.cement.replace('x', '');
    if (sumCrystal) sumCrystal.textContent = data.materials.crystal.replace('x', '');
  }

