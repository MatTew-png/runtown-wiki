---
import CyberIcon from './CyberIcon.astro';

// Real RUN TOWN Patch 1.3.0 Weapon Crafting Data
const weapons = [
  {
    id: 'machete',
    name: 'Machete Lv.1',
    damage: 18,
    type: 'edge',
    typeLabel: 'สายคม (Edge Core)',
    color: '#ff4d6d',
    borderClass: 'border-rose-500/50 hover:border-rose-400',
    bgClass: 'bg-rose-500/10',
    textClass: 'text-rose-400',
    icon: '/items/icons/transparent/machete_lv1.png',
    blueprintIcon: '/items/icons/transparent/blueprint_machete_lv1.png',
    blueprintName: 'Blueprint: Machete LV1 x1',
    baseWeapon: 'Bottle (ขวดแตก) x1',
    baseWeaponIcon: '/items/icons/transparent/bottle.png',
    coreType: 'edge',
    coreName: 'Edge Core',
    coreIcon: '/items/icons/transparent/edge_core.png',
    coreCount: 100,
    crystalCount: 100,
    tableFee: 250000,
    boxCostPerUnit: 10000,
    materials: {
      cement: 200,   // 2 * 100
      wood: 1000,    // 10 * 100
      steel: 2000,   // 20 * 100
      gold: 500,     // 5 * 100
      crystal: 100,
    },
    totalFee: 1250000, // 250k table + 1,000,000 (100 boxes * 10k)
    badge: 'DMG 18 · สูงสุดในเซิร์ฟ',
    desc: 'อาวุธประชิดที่รุนแรงที่สุดในแพตช์ 1.3.0 โจมตี 6-7 ครั้งสามารถน็อกผู้เล่นเลือด 100 ได้ทันที',
  },
  {
    id: 'knife',
    name: 'Knife Lv.1',
    damage: 16,
    type: 'edge',
    typeLabel: 'สายคม (Edge Core)',
    color: '#ff4d6d',
    borderClass: 'border-rose-500/50 hover:border-rose-400',
    bgClass: 'bg-rose-500/10',
    textClass: 'text-rose-400',
    icon: '/items/icons/transparent/knife_lv1.png',
    blueprintIcon: '/items/icons/transparent/blueprint_knife_lv1.png',
    blueprintName: 'Blueprint: Knife LV1 x1',
    baseWeapon: 'Bottle (ขวดแตก) x1',
    baseWeaponIcon: '/items/icons/transparent/bottle.png',
    coreType: 'edge',
    coreName: 'Edge Core',
    coreIcon: '/items/icons/transparent/edge_core.png',
    coreCount: 100,
    crystalCount: 100,
    tableFee: 350000,
    boxCostPerUnit: 10000,
    materials: {
      cement: 200,
      wood: 1000,
      steel: 2000,
      gold: 500,
      crystal: 100,
    },
    totalFee: 1350000, // 350k table + 1M boxes
    badge: 'DMG 16 · มีดพกสมดุล',
    desc: 'มีดสั้นมาตรฐานของสายไฟต์ มีความคล่องตัวสูง ดาเมจ 16 หน่วยต่อการฟัน 1 ครั้ง',
  },
  {
    id: 'dagger',
    name: 'Dagger Lv.1',
    damage: 16,
    type: 'impact',
    typeLabel: 'สายแทง (Impact Core)',
    color: '#45f2b4',
    borderClass: 'border-mint/50 hover:border-mint',
    bgClass: 'bg-mint/10',
    textClass: 'text-mint',
    icon: '/items/icons/transparent/dagger_lv1.png',
    blueprintIcon: '/items/icons/transparent/blueprint_knife_lv1.png',
    blueprintName: 'Blueprint: Knife LV1 x1',
    baseWeapon: 'Bottle (ขวดแตก) x1',
    baseWeaponIcon: '/items/icons/transparent/bottle.png',
    coreType: 'impact',
    coreName: 'Impact Core',
    coreIcon: '/items/icons/transparent/impact_core.png',
    coreCount: 100,
    crystalCount: 100,
    tableFee: 350000,
    boxCostPerUnit: 10000,
    materials: {
      cement: 200,
      wood: 1000,
      steel: 2000,
      gold: 500,
      crystal: 100,
    },
    totalFee: 1350000,
    badge: 'DMG 16 · มีดสั้นกระแทก',
    desc: 'แดกเกอร์ที่ใช้ Impact Core แกนกระแทกในการหลอม ดาเมจ 16 รวดเร็วและชะงักสูง',
  },
  {
    id: 'knuckle',
    name: 'Knuckle Lv.1',
    damage: 14,
    type: 'impact',
    typeLabel: 'สายหมัด (Impact Core)',
    color: '#facc15',
    borderClass: 'border-amber-400/50 hover:border-amber-400',
    bgClass: 'bg-amber-400/10',
    textClass: 'text-amber-300',
    icon: '/items/icons/transparent/knuckle_lv1.png',
    blueprintIcon: '/items/icons/transparent/blueprint_knuckle_lv1.png',
    blueprintName: 'Blueprint: Knuckle LV1 x1',
    baseWeapon: 'ไม่ต้องใช้เบสอาวุธ',
    baseWeaponIcon: '',
    coreType: 'impact',
    coreName: 'Impact Core',
    coreIcon: '/items/icons/transparent/impact_core.png',
    coreCount: 75,
    crystalCount: 100,
    tableFee: 250000,
    boxCostPerUnit: 10000,
    materials: {
      cement: 150,  // 2 * 75
      wood: 750,    // 10 * 75
      steel: 1500,  // 20 * 75
      gold: 375,    // 5 * 75
      crystal: 100,
    },
    totalFee: 1000000, // 250k table + 750k boxes
    badge: 'DMG 14 · คราฟต์ตรงได้เลย',
    desc: 'จุดเด่นที่สุดคือ ไม่ต้องใช้เบสอาวุธตั้งต้น คราฟต์ขึ้นตรงได้ทันทีและใช้คอร์เพียง 75 ชิ้น',
  },
  {
    id: 'poolcue',
    name: 'Poolcue Lv.1',
    damage: 12,
    type: 'impact',
    typeLabel: 'สายทุบ (Impact Core)',
    color: '#38bdf8',
    borderClass: 'border-cyan-400/50 hover:border-cyan-400',
    bgClass: 'bg-cyan-400/10',
    textClass: 'text-cyan-300',
    icon: '/items/icons/transparent/poolcue_lv1.png',
    blueprintIcon: '/items/icons/transparent/blueprint_poolcue_lv1.png',
    blueprintName: 'Blueprint: Pool Cue LV1 x1',
    baseWeapon: 'Bat หรือ Golf Club x1',
    baseWeaponIcon: '/items/icons/transparent/bat.png',
    coreType: 'impact',
    coreName: 'Impact Core',
    coreIcon: '/items/icons/transparent/impact_core.png',
    coreCount: 150,
    crystalCount: 150,
    tableFee: 350000,
    boxCostPerUnit: 10000,
    materials: {
      cement: 300,  // 2 * 150
      wood: 1500,   // 10 * 150
      steel: 3000,  // 20 * 150
      gold: 750,    // 5 * 150
      crystal: 150,
    },
    totalFee: 1850000, // 350k table + 1.5M boxes
    badge: 'DMG 12 · ระยะฟาดกว้าง',
    desc: 'อาวุธประชิดสายทุบยาว เหมาะสำหรับไฟต์แบบรักษาระยะและมีอัตราชะงักศัตรูต่อเนื่อง',
  },
];
---

<section id="crafting" class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24 border-t border-line">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <p class="font-mono text-xs font-semibold tracking-[0.2em] text-lime uppercase">// CRAFTING PRODUCTION TREE</p>
        <span class="inline-flex items-center gap-1 rounded-full border border-lime/30 bg-lime/10 px-2.5 py-0.5 font-mono text-[10px] font-bold text-lime">
          PATCH 1.3.0
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
        ผังสายการผลิตวัตถุดิบ & อาวุธ (Production Tree)
      </h2>
      <p class="text-sm text-textSoft max-w-2xl leading-relaxed">
        แผนภาพโครงสร้างสายการผลิต (Hierarchy Tree) แสดงการเชื่อมโยงจาก <strong>วัตถุดิบงานขาวต้นน้ำ ➔ การแปรรูป ➔ การตีกล่องและแกนคอร์ ➔ ขึ้นรูปอาวุธสำเร็จรูป</strong>
      </p>
    </div>

    <!-- Quick Action Badge -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/guides/crafting/weapons"
        class="inline-flex items-center gap-1.5 rounded-xl border border-lime/40 bg-lime/10 px-4 py-2.5 font-mono text-xs font-bold text-lime hover:bg-lime hover:text-slate-950 transition-all shadow-[0_0_20px_-5px_rgba(165,255,95,0.3)]"
      >
        <CyberIcon name="swords" class="size-4" />
        <span>ดูสถิติดาเมจทั้ง 5 ชนิด ➔</span>
      </a>
    </div>
  </div>

  <!-- Weapon Selector Tabs (Root Node Switcher) -->
  <div class="mt-8 space-y-2">
    <span class="block font-mono text-xs text-textMuted uppercase tracking-wider">
      เลือกอาวุธเป้าหมายเพื่อแสดงผังต้นไม้การผลิต:
    </span>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5" id="craftTreeTabs">
      {weapons.map((w, idx) => (
        <button
          type="button"
          class={`craft-weapon-btn group relative flex items-center gap-2.5 p-3 rounded-xl border text-left transition-all ${
            idx === 0
              ? 'border-lime bg-lime/10 shadow-[0_0_20px_-5px_rgba(165,255,95,0.4)] active ring-1 ring-lime'
              : 'border-line bg-card/70 hover:border-lime/40 hover:bg-paper/80'
          }`}
          data-weapon-id={w.id}
        >
          <div class="size-11 shrink-0 rounded-lg bg-slate-950/80 border border-lineSubtle p-1 flex items-center justify-center group-hover:scale-105 transition-transform">
            <img src={w.icon} alt={w.name} class="size-9 object-contain drop-shadow" />
          </div>
          <div class="min-w-0 flex-1">
            <strong class="block text-xs font-bold text-white truncate group-hover:text-lime transition-colors">
              {w.name}
            </strong>
            <span class="block font-mono text-[10px] text-lime font-bold">
              DMG {w.damage}
            </span>
            <span class="block text-[10px] text-textMuted truncate">
              {w.type === 'edge' ? '🩸 Edge Core' : '💥 Impact Core'}
            </span>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Interactive Tree Canvas Container -->
  <div class="mt-8 rounded-3xl border border-line bg-card/90 p-4 sm:p-6 lg:p-8 backdrop-blur-xl shadow-neon-card relative overflow-hidden">
    
    <!-- Top Bar: Active Weapon Summary & Flow Indicator -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-lineSubtle font-mono text-xs">
      <div class="flex items-center gap-2.5">
        <span class="size-2 rounded-full bg-lime animate-pulse"></span>
        <span class="text-textMuted">กำลังแสดงผังสายตรงสำหรับ:</span>
        <strong id="treeActiveName" class="text-white font-bold text-sm">Machete Lv.1</strong>
        <span id="treeActiveBadge" class="rounded px-2 py-0.5 text-[10px] font-bold bg-rose-500/10 border border-rose-500/30 text-rose-400">
          DMG 18 · สูงสุดในเซิร์ฟ
        </span>
      </div>

      <div class="flex items-center gap-3 text-textMuted text-[11px]">
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-amber-400"></span>
          <span>Tier 1 วัตถุดิบดิบ</span>
        </span>
        <span>➔</span>
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-cyan-400"></span>
          <span>Tier 2 แปรรูป</span>
        </span>
        <span>➔</span>
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-purple-400"></span>
          <span>Tier 3 แกนคอร์</span>
        </span>
        <span>➔</span>
        <span class="flex items-center gap-1.5">
          <span class="size-2 rounded-full bg-lime"></span>
          <span>Tier 4 อาวุธ</span>
        </span>
      </div>
    </div>

    <!-- Tree Viewport (Scrollable horizontally on small screens) -->
    <div class="mt-8 overflow-x-auto pb-4">
      <div class="min-w-[880px] grid grid-cols-4 gap-6 lg:gap-8 items-stretch relative">
        
        <!-- ================= STAGE 1: RAW MATERIALS (รากฐาน - แหล่งฟาร์มดิบ) ================= -->
        <div class="space-y-4 flex flex-col justify-between">
          <div class="flex items-center justify-between pb-2 border-b border-amber-400/30">
            <span class="font-mono text-xs font-bold text-amber-400 flex items-center gap-1.5">
              <span class="grid size-5 place-items-center rounded-full bg-amber-400/20 text-[10px]">1</span>
              <span>วัตถุดิบงานขาวต้นน้ำ</span>
            </span>
            <span class="text-[10px] font-mono text-textMuted">ฟาร์มธรรมชาติ</span>
          </div>

          <div class="space-y-3 flex-1 flex flex-col justify-around">
            <!-- Node: Raw Stone -->
            <div class="tree-node group p-3 rounded-2xl border border-line bg-paper/70 hover:border-amber-400/40 transition-all flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 place-items-center rounded-xl bg-slate-900 border border-lineSubtle">
                  <CyberIcon name="package" class="size-4 text-amber-400" />
                </span>
                <div>
                  <strong class="text-xs font-bold text-white block">หินดิบ (Raw Stone)</strong>
                  <span class="font-mono text-[10px] text-textMuted">⛏️ เหมือง Davis Quartz</span>
                </div>
              </div>
              <span class="font-mono text-[11px] text-amber-300 font-bold">โม่ปูน</span>
            </div>

            <!-- Node: Wood Log -->
            <div class="tree-node group p-3 rounded-2xl border border-line bg-paper/70 hover:border-amber-400/40 transition-all flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 place-items-center rounded-xl bg-slate-900 border border-lineSubtle">
                  <CyberIcon name="tree" class="size-4 text-amber-400" />
                </span>
                <div>
                  <strong class="text-xs font-bold text-white block">ท่อนไม้ (Wood Log)</strong>
                  <span class="font-mono text-[10px] text-textMuted">🪓 โรงตัดไม้ Paleto</span>
                </div>
              </div>
              <span class="font-mono text-[11px] text-amber-300 font-bold">เลื่อยแพ็ค</span>
            </div>

            <!-- Node: Scrap Metal -->
            <div class="tree-node group p-3 rounded-2xl border border-line bg-paper/70 hover:border-amber-400/40 transition-all flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 place-items-center rounded-xl bg-slate-900 border border-lineSubtle">
                  <CyberIcon name="wrench" class="size-4 text-amber-400" />
                </span>
                <div>
                  <strong class="text-xs font-bold text-white block">เศษเหล็ก (Scrap)</strong>
                  <span class="font-mono text-[10px] text-textMuted">⚙️ กองขยะ / จุดจี่</span>
                </div>
              </div>
              <span class="font-mono text-[11px] text-amber-300 font-bold">จี่เหล็ก</span>
            </div>

            <!-- Node: Gold Ore -->
            <div class="tree-node group p-3 rounded-2xl border border-line bg-paper/70 hover:border-amber-400/40 transition-all flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 place-items-center rounded-xl bg-slate-900 border border-lineSubtle">
                  <CyberIcon name="gem" class="size-4 text-amber-400" />
                </span>
                <div>
                  <strong class="text-xs font-bold text-white block">แร่ทองคำ (Gold Ore)</strong>
                  <span class="font-mono text-[10px] text-textMuted">💎 จุดร่อนแร่แม่น้ำ</span>
                </div>
              </div>
              <span class="font-mono text-[11px] text-amber-300 font-bold">หลอมแท่ง</span>
            </div>

            <!-- Node: Raw Crystal -->
            <div class="tree-node group p-3 rounded-2xl border border-line bg-paper/70 hover:border-cyan-400/40 transition-all flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="grid size-9 place-items-center rounded-xl bg-slate-900 border border-lineSubtle">
                  <CyberIcon name="gem" class="size-4 text-cyan-400" />
                </span>
                <div>
                  <strong class="text-xs font-bold text-white block">ทรายคริสตัล (Raw)</strong>
                  <span class="font-mono text-[10px] text-textMuted">🌊 หาดร่อนคริสตัล</span>
                </div>
              </div>
              <span class="font-mono text-[11px] text-cyan-300 font-bold">หลอมแท่ง</span>
            </div>
          </div>
        </div>

        <!-- ================= STAGE 2: PROCESSED MATERIALS (ลำต้น - ชิ้นส่วนแปรรูป) ================= -->
        <div class="space-y-4 flex flex-col justify-between">
          <div class="flex items-center justify-between pb-2 border-b border-cyan-400/30">
            <span class="font-mono text-xs font-bold text-cyan-400 flex items-center gap-1.5">
              <span class="grid size-5 place-items-center rounded-full bg-cyan-400/20 text-[10px]">2</span>
              <span>ชิ้นส่วนแปรรูป (โพร)</span>
            </span>
            <span class="text-[10px] font-mono text-textMuted">โรงงานแปรรูป</span>
          </div>

          <div class="space-y-3 flex-1 flex flex-col justify-around">
            <!-- Node: Cement -->
            <div class="tree-node p-3 rounded-2xl border border-line bg-paper/80 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src="/items/icons/transparent/cement.png" alt="Cement" class="size-8 object-contain" />
                <div>
                  <strong class="text-xs font-bold text-white block">Cement (ปูน)</strong>
                  <span class="font-mono text-[10px] text-textMuted">ถุงละ 2 ชิ้น / กล่อง</span>
                </div>
              </div>
              <span id="treeQtyCement" class="font-mono text-xs font-bold text-cyan-300">x200</span>
            </div>

            <!-- Node: Wood Crate -->
            <div class="tree-node p-3 rounded-2xl border border-line bg-paper/80 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src="/items/icons/transparent/wood_crate.png" alt="Wood Crate" class="size-8 object-contain" />
                <div>
                  <strong class="text-xs font-bold text-white block">Wood Crate (ลังไม้)</strong>
                  <span class="font-mono text-[10px] text-textMuted">ลังละ 10 ชิ้น / กล่อง</span>
                </div>
              </div>
              <span id="treeQtyWood" class="font-mono text-xs font-bold text-cyan-300">x1,000</span>
            </div>

            <!-- Node: Steel Ingot -->
            <div class="tree-node p-3 rounded-2xl border border-line bg-paper/80 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src="/items/icons/transparent/steel_ingot.png" alt="Steel Ingot" class="size-8 object-contain" />
                <div>
                  <strong class="text-xs font-bold text-white block">Steel Ingot (เหล็กแท่ง)</strong>
                  <span class="font-mono text-[10px] text-textMuted">แท่งละ 20 ชิ้น / กล่อง</span>
                </div>
              </div>
              <span id="treeQtySteel" class="font-mono text-xs font-bold text-cyan-300">x2,000</span>
            </div>

            <!-- Node: Gold Ingot -->
            <div class="tree-node p-3 rounded-2xl border border-line bg-paper/80 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src="/items/icons/transparent/gold_ingot.png" alt="Gold Ingot" class="size-8 object-contain" />
                <div>
                  <strong class="text-xs font-bold text-white block">Gold Ingot (ทองแท่ง)</strong>
                  <span class="font-mono text-[10px] text-textMuted">แท่งละ 5 ชิ้น / กล่อง</span>
                </div>
              </div>
              <span id="treeQtyGold" class="font-mono text-xs font-bold text-cyan-300">x500</span>
            </div>

            <!-- Node: Crystal Ingot (Direct feed to Stage 4) -->
            <div class="tree-node p-3 rounded-2xl border border-cyan-400/40 bg-cyan-400/10 flex items-center justify-between shadow-[0_0_15px_-4px_rgba(56,189,248,0.3)]">
              <div class="flex items-center gap-2.5">
                <img src="/items/icons/transparent/crystal_ingot.png" alt="Crystal Ingot" class="size-8 object-contain" />
                <div>
                  <strong class="text-xs font-bold text-white block">Crystal Ingot (คริสตัล)</strong>
                  <span class="font-mono text-[10px] text-cyan-300">เข้าโต๊ะคราฟต์โดยตรง</span>
                </div>
              </div>
              <span id="treeQtyCrystal" class="font-mono text-xs font-bold text-cyan-300">x100</span>
            </div>
          </div>
        </div>

        <!-- ================= STAGE 3: BOX SETS & CORES (กิ่งก้าน - ตีกล่อง & หลอมคอร์) ================= -->
        <div class="space-y-4 flex flex-col justify-between">
          <div class="flex items-center justify-between pb-2 border-b border-purple-400/30">
            <span class="font-mono text-xs font-bold text-purple-400 flex items-center gap-1.5">
              <span class="grid size-5 place-items-center rounded-full bg-purple-400/20 text-[10px]">3</span>
              <span>กล่องอาวุธ & แกนคอร์</span>
            </span>
            <span class="text-[10px] font-mono text-textMuted">โต๊ะช่างตีกล่อง</span>
          </div>

          <div class="space-y-4 flex-1 flex flex-col justify-center">
            
            <!-- Step 3.1: Weapon Box Set -->
            <div class="tree-node p-3.5 rounded-2xl border border-line bg-paper/90 relative group">
