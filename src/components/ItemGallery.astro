<div class="space-y-6">
  <!-- Header & Filters -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-line">
    <div>
      <span class="text-xs font-mono font-bold text-mint uppercase tracking-wider">// REAL IN-GAME CRAFTING SCREENSHOTS</span>
      <h3 class="text-xl sm:text-2xl font-display font-extrabold text-white flex items-center gap-2">
        <CyberIcon name="wrench" class="size-6 text-mint inline-block" /> คลังรูปภาพสูตรคราฟต์จริง (Patch 1.3.0 Item Gallery)
      </h3>
    </div>
    
    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-xl bg-paper border border-line" id="galleryFilterNav">
      <button type="button" data-filter="all" class="gallery-tab active px-3 py-1.5 text-xs font-mono font-bold rounded-lg transition-colors bg-mint text-dark">
        ทั้งหมด ({items.length})
      </button>
      <button type="button" data-filter="weapons" class="gallery-tab px-3 py-1.5 text-xs font-mono font-medium rounded-lg transition-colors text-textSoft hover:text-white hover:bg-card">
        <CyberIcon name="swords" class="size-3.5 inline mr-1" /> อาวุธ Lv.1
      </button>
      <button type="button" data-filter="base" class="gallery-tab px-3 py-1.5 text-xs font-mono font-medium rounded-lg transition-colors text-textSoft hover:text-white hover:bg-card">
        <CyberIcon name="shield-check" class="size-3.5 inline mr-1" /> อาวุธเบส (5%)
      </button>
      <button type="button" data-filter="blueprints" class="gallery-tab px-3 py-1.5 text-xs font-mono font-medium rounded-lg transition-colors text-textSoft hover:text-white hover:bg-card">
        <CyberIcon name="file-text" class="size-3.5 inline mr-1" /> พิมพ์เขียว
      </button>
      <button type="button" data-filter="materials" class="gallery-tab px-3 py-1.5 text-xs font-mono font-medium rounded-lg transition-colors text-textSoft hover:text-white hover:bg-card">
        <CyberIcon name="gem" class="size-3.5 inline mr-1" /> แกนคอร์ & แร่
      </button>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="galleryGrid">
    {items.map((item) => (
      <div 
        data-category={item.category}
        class="gallery-card p-4 rounded-2xl border border-line bg-card hover:border-mint transition-all shadow-neon-card space-y-3 group flex flex-col justify-between"
      >
        <div class="space-y-3">
          <!-- Card Header with Transparent Icon Preview -->
          <div class="flex items-center gap-3 pb-2 border-b border-lineSubtle">
            <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-white/5 to-white/10 border border-white/15 p-1.5 flex items-center justify-center shrink-0 shadow-inner group-hover:border-mint/50 transition-colors">
              <img src={item.icon} alt={item.name} class="w-full h-full object-contain drop-shadow-md group-hover:scale-110 transition-transform" style="image-rendering: -webkit-optimize-contrast;" />
              <span class="absolute -bottom-1 -right-1 px-1 text-[8px] font-mono font-bold bg-dark text-mint border border-mint/40 rounded">PNG</span>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="text-sm font-bold text-white break-words leading-tight group-hover:text-mint transition-colors">{item.name}</h4>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="text-[11px] font-mono text-textMuted">{item.type}</span>
                <span class={`text-[9px] font-mono px-1.5 py-0.5 rounded-full border font-bold shrink-0 ${item.badgeColor}`}>
                  {item.badge}
                </span>
              </div>
            </div>
          </div>

          <!-- Thumbnail with Zoom overlay -->
          <div 
            class="relative w-full aspect-[16/10] bg-black/60 rounded-xl overflow-hidden border border-white/10 group-hover:border-mint/50 transition-colors cursor-pointer" 
            onclick={`openImgModal('${item.image}', '${item.name}')`}
          >
            <img 
              src={item.image} 
              alt={item.name} 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
              style="image-rendering: -webkit-optimize-contrast;"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between text-[11px] font-mono gap-1">
              <span class="text-white font-bold drop-shadow text-[11px] break-words">{item.name}</span>
              <span class="px-2 py-0.5 rounded bg-black/90 text-mint border border-mint/40 text-[10px] font-bold shrink-0">
                {item.category === 'materials' ? 'การ์ดไอเทม HD' : 'จอเกมจริง'}
              </span>
            </div>
          </div>

          <!-- Stats & Recipe -->
          <div class="p-3 rounded-xl border border-lineSubtle bg-paper/90 space-y-2 text-xs font-mono">
            <div class="text-white font-bold text-[11px] flex items-center gap-1.5">
              <CyberIcon name="bar-chart-2" class="size-3.5 text-mint" />
              <span>{item.stats}</span>
            </div>
            <div class="text-[11px] text-textSoft space-y-0.5 border-t border-white/10 pt-2">
              <span class="text-textMuted block text-[10px] uppercase font-bold tracking-wider">// วัตถุดิบที่ใช้:</span>
              {item.recipe.map((r) => (
                <div class="text-slate-200 flex items-start gap-1">
                  <span class="text-mint font-bold shrink-0">•</span>
                  <span class="break-words">{r}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="pt-2.5 flex items-center justify-between text-xs font-mono border-t border-lineSubtle">
          <div>
            <span class="text-textMuted text-[10px] block">ค่าธรรมเนียม:</span>
            <strong class="text-lime font-bold">{item.cost}</strong>
          </div>
          <a 
            href={item.icon} 
            download={`${item.id}_512.png`}
            class="px-2.5 py-1 rounded-lg bg-card hover:bg-mint hover:text-dark text-mint border border-mint/30 hover:border-mint transition-colors text-[10px] font-bold flex items-center gap-1 shadow-sm"
            title="ดาวน์โหลดภาพโปร่งใส 512x512"
          >
            <CyberIcon name="package" class="size-3 inline mr-1" /> โหลด PNG
          </a>
        </div>

      </div>
    ))}
  </div>

  <!-- Image Modal Dialog -->
  <div id="itemImgModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="relative max-w-4xl w-full bg-card border border-mint/50 rounded-2xl p-4 shadow-neon-card space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-line">
        <h4 id="modalImgTitle" class="text-base font-display font-bold text-white">รูปภาพสูตรคราฟต์</h4>
        <button type="button" onclick="closeImgModal()" class="w-8 h-8 rounded-lg bg-paper border border-line text-white hover:text-danger font-bold text-sm">✕</button>
      </div>
      <div class="w-full max-h-[75vh] overflow-auto rounded-xl border border-white/10 bg-black flex items-center justify-center">
        <img id="modalImgTag" src="" alt="Craft Screenshot" class="max-w-full max-h-[72vh] object-contain mx-auto" />
      </div>
    </div>
  </div>

</div>

<script is:inline>
  function openImgModal(src, title) {
    const modal = document.getElementById('itemImgModal');
    const img = document.getElementById('modalImgTag');
    const titleEl = document.getElementById('modalImgTitle');
    if (modal && img && titleEl) {
      img.src = src;
      titleEl.textContent = title;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeImgModal() {
    const modal = document.getElementById('itemImgModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  // Filter tabs handling
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#galleryFilterNav button');
    const cards = document.querySelectorAll('.gallery-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-filter');
        
        // Update active button state
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-mint', 'text-dark');
          b.classList.add('text-textSoft');
        });
        btn.classList.add('active', 'bg-mint', 'text-dark');
        btn.classList.remove('text-textSoft');

        // Filter cards
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (target === 'all' || category === target) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

