---
import CyberIcon from './CyberIcon.astro';

const vehicles = [
  { id: 'bati', name: 'Pegassi Bati 801', category: 40, capacity: 40, speed: 215, fuel: 'B', price: 15000, priceType: 'buy', badge: 'FASTEST SPEED', jobs: ['ดอกไม้', 'จี่เหล็ก'] },
  { id: 'sanchez', name: 'Maibatsu Sanchez', category: 40, capacity: 40, speed: 160, fuel: 'A', price: 350, priceType: 'rent', badge: 'OFF-ROAD SCOUT', jobs: ['ดอกไม้'] },
  { id: 'sultan', name: 'Karin Sultan', category: 60, capacity: 60, speed: 192, fuel: 'B', price: 35000, priceType: 'buy', badge: 'BEST ALL-ROUNDER', jobs: ['จี่เหล็ก', 'หมู'] },
  { id: 'tailgater', name: 'Obey Tailgater', category: 60, capacity: 60, speed: 180, fuel: 'A', price: 28000, priceType: 'buy', badge: 'FUEL SAVER', jobs: ['จี่เหล็ก'] },
  { id: 'rebel', name: 'Karin Rebel', category: 120, capacity: 120, speed: 155, fuel: 'B', price: 22000, priceType: 'buy', badge: 'PORK & WOOD PICK', jobs: ['หมู', 'ไม้'] },
  { id: 'sadler', name: 'Vapid Sadler', category: 120, capacity: 120, speed: 150, fuel: 'C', price: 26000, priceType: 'buy', badge: 'HEAVY DUTY', jobs: ['ไม้', 'หมู'] },
  { id: 'rumpo', name: 'Bravado Rumpo', category: 150, capacity: 150, speed: 140, fuel: 'C', price: 30000, priceType: 'buy', badge: 'MAX CARGO', jobs: ['ไม้', 'หมู', 'ดอกไม้'] },
  { id: 'speedo', name: 'Vapid Speedo', category: 150, capacity: 150, speed: 135, fuel: 'B', price: 900, priceType: 'rent', badge: 'RENTAL VALUE', jobs: ['ไม้', 'หมู'] },
];

const tabs = [
  { value: 0, label: 'ทั้งหมด (All)' },
  { value: 40, label: 'มอเตอร์ไซค์ (40 kg)' },
  { value: 60, label: 'รถเก๋ง/สปอร์ต (60 kg)' },
  { value: 120, label: 'กระบะบรรทุก (120 kg)' },
  { value: 150, label: 'รถตู้/เฮฟวี่ (150 kg)' },
];

const fuelColor: Record<string, string> = {
  A: 'text-mint',
  B: 'text-[#facc15]',
  C: 'text-danger',
};
---

<section id="vehicles" class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-24 border-t border-line">
  <div class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="font-mono text-xs font-semibold tracking-[0.2em] text-amber-400 uppercase">// VEHICLE LOGISTICS</p>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/10 px-3 py-1 font-mono text-xs font-bold text-amber-300">
        <CyberIcon name="lock" class="size-3.5 text-amber-400" />
        <span>ปิดปรับปรุงชั่วคราว · รออัปเดตข้อมูล</span>
      </span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
      โชว์รูมรถขนของ & ตารางเปรียบเทียบ
    </h2>
    <p class="text-sm text-textSoft max-w-2xl leading-relaxed">
      เลือกรถให้ตรงกับงาน ดูความจุท้ายรถ ความเร็ว อัตราสิ้นเปลือง และเลือก 2 คันเพื่อเทียบแบบเคียงข้าง (ปิดปรับปรุงระบบชั่วคราวเพื่อรออัปเดตสเปกและราคาตามแพตช์ล่าสุด)
    </p>

    <!-- Quick link to Sport Tuning Guide & Calculator -->
    <div class="pt-2">
      <a
        href="/guides/logistics/sport-tuning"
        class="inline-flex items-center gap-2 rounded-xl border border-mint/40 bg-mint/10 px-4 py-2 font-mono text-xs font-bold text-mint hover:bg-mint hover:text-slate-950 transition-all shadow-[0_0_15px_rgba(69,242,180,0.15)]"
      >
        <CyberIcon name="gauge" class="size-4" />
        <span>🏎️ เครื่องคิดเลขแต่งรถ SPORT (7 หมวด สเตจสะสม) ➔</span>
      </a>
    </div>
  </div>

  <!-- Content Container with Visual Lock Overlay: ปิดแบบมองเห็นได้ (Disabled & Maintenance Overlay) -->
  <div class="relative mt-8">
    <!-- Dimmed / Disabled Underlying Content (ยังมองเห็นโครงสร้างรถและสเปกได้ทั้งหมด) -->
    <div inert aria-hidden="true" class="opacity-30 grayscale-[50%] pointer-events-none select-none filter blur-[0.5px]">
      <!-- Filter Tabs -->
      <div class="flex gap-2 overflow-x-auto pb-2" id="vehTabs">
        {tabs.map((t, idx) => (
          <button
            type="button"
            class={`veh-tab-btn shrink-0 rounded-full border px-4 py-2 text-xs font-mono transition-colors ${
              idx === 0
                ? 'border-mint bg-mint text-slate-950 font-bold active'
                : 'border-line bg-card text-textSoft hover:border-mint/40 hover:text-white'
            }`}
            data-filter={t.value}
            disabled
          >
            {t.label}
          </button>
        ))}
      </div>

      <!-- Vehicles Grid -->
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4" id="vehGrid">
        {vehicles.map((v) => (
          <div
            class="veh-card group flex flex-col justify-between rounded-2xl border border-line bg-card/80 p-5 backdrop-blur-md transition-all duration-300 shadow-sm"
            data-id={v.id}
            data-cat={v.category}
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded border border-amber-400/40 bg-amber-400/10 px-2 py-0.5 font-mono text-[10px] font-bold tracking-wider text-amber-300">
                  {v.badge}
                </span>
                <span class="text-xs font-mono text-textMuted">{v.category} KG</span>
              </div>

              <h3 class="mt-3 text-lg font-display font-bold text-white">
                {v.name}
              </h3>

              <div class="mt-4 space-y-1.5">
                <div class="flex items-center justify-between font-mono text-xs text-textSoft">
                  <span class="flex items-center gap-1.5 text-textMuted">
                    <CyberIcon name="package" class="size-3.5 text-mint" />
                    <span>TRUNK</span>
                  </span>
                  <span class="text-white font-bold">{v.capacity} / 150 kg</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-slate-900 border border-lineSubtle">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-mint/60 to-mint"
                    style={`width: ${(v.capacity / 150) * 100}%`}
                  ></div>
                </div>
              </div>

              <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-lineSubtle pt-3 text-center font-mono">
                <div>
                  <dt class="text-[10px] text-textMuted">ความเร็ว</dt>
                  <dd class="mt-0.5 text-xs font-bold text-white">{v.speed} km/h</dd>
                </div>
                <div>
                  <dt class="text-[10px] text-textMuted">น้ำมัน</dt>
                  <dd class={`mt-0.5 text-xs font-bold ${fuelColor[v.fuel]}`}>เกรด {v.fuel}</dd>
                </div>
                <div>
                  <dt class="text-[10px] text-textMuted">{v.priceType === 'buy' ? 'ราคาซื้อ' : 'ค่าเช่า'}</dt>
                  <dd class="mt-0.5 text-xs font-bold text-amber-300">
                    {v.priceType === 'buy' ? `${v.price.toLocaleString()} RD` : `${v.price} RD/วัน`}
                  </dd>
                </div>
              </dl>
            </div>

            <button
              type="button"
              class="veh-compare-btn mt-5 inline-flex items-center justify-center gap-1.5 rounded-xl border border-line bg-paper/60 px-4 py-2 text-xs font-mono font-semibold text-white/50"
              disabled
            >
              <CyberIcon name="lock" class="size-3.5 text-amber-400" />
              <span>ปิดการเปรียบเทียบ</span>
            </button>
          </div>
        ))}
      </div>
    </div>

    <!-- Centered Cyberpunk Maintenance Banner Overlay -->
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="max-w-md rounded-2xl border border-amber-400/40 bg-slate-950/90 p-6 sm:p-8 backdrop-blur-xl shadow-[0_0_50px_rgba(251,191,36,0.18)] text-center space-y-4">
        <div class="mx-auto grid size-14 place-items-center rounded-2xl border border-amber-400/40 bg-amber-400/10 text-amber-400 shadow-[0_0_20px_rgba(251,191,36,0.2)]">
          <CyberIcon name="lock" class="size-7" />
        </div>
        <div class="space-y-2">
          <span class="inline-block font-mono text-[11px] font-bold uppercase tracking-widest text-amber-400 bg-amber-400/10 border border-amber-400/30 px-3 py-1 rounded-full">
            UNDER MAINTENANCE · ปิดปรับปรุงชั่วคราว
          </span>
          <h3 class="text-xl sm:text-2xl font-display font-bold text-white tracking-tight">
            โชว์รูมรถขนของ & ตารางเปรียบเทียบ
          </h3>
          <p class="text-xs sm:text-sm text-textSoft leading-relaxed font-sans">
            ระบบโชว์รูมและตารางเปรียบเทียบสเปกรถขนของ (60, 120, 150 kg) อยู่ระหว่างรอข้อมูลรายชื่อรถจริงและราคาให้ตรงกับแพตช์ปัจจุบันของเซิร์ฟเวอร์
          </p>
        </div>
        <div class="pt-2">
          <div class="inline-flex items-center gap-2 rounded-lg border border-line bg-paper/90 px-3.5 py-1.5 font-mono text-[11px] text-textMuted">
            <span class="size-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>สถานะ: ปิดการใช้งานชั่วคราว (แสดงตัวอย่างโครงสร้าง)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Compare Floating Drawer -->
  <div
    id="vehCompareDrawer"
    class="hidden fixed inset-x-0 bottom-0 z-50 border-t border-mint/40 bg-slate-950/95 backdrop-blur-xl transition-all duration-300 shadow-[0_-10px_30px_rgba(0,0,0,0.8)]"
  >
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
      <div class="flex items-center justify-between pb-2 border-b border-lineSubtle">
        <p class="flex items-center gap-2 font-mono text-xs tracking-widest text-mint font-bold">
          <CyberIcon name="git-compare" class="size-4" />
          <span>COMPARE VEHICLES (<span id="vehCompareCount">0</span>/2)</span>
        </p>
        <button
          type="button"
          id="vehClearCompare"
          class="inline-flex items-center gap-1 text-xs font-mono text-textMuted hover:text-danger transition-colors"
        >
          <CyberIcon name="x" class="size-3.5" />
          <span>ล้างทั้งหมด</span>
        </button>
      </div>

      <div id="vehCompareContent" class="pt-3">
        <p class="text-xs text-textMuted font-mono py-2 text-center">
          เลือก 2 คันเพื่อดูตารางเปรียบเทียบสเปกเคียงข้างกัน
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  interface VehicleSpec {
    id: string;
    name: string;
    capacity: number;
    speed: number;
    fuel: string;
    price: string;
    jobs: string[];
  }

  const vehiclesData: Record<string, VehicleSpec> = {
    bati: { id: 'bati', name: 'Pegassi Bati 801', capacity: 40, speed: 215, fuel: 'B', price: '15,000 RD', jobs: ['ดอกไม้', 'จี่เหล็ก'] },
    sanchez: { id: 'sanchez', name: 'Maibatsu Sanchez', capacity: 40, speed: 160, fuel: 'A', price: '350 RD/วัน', jobs: ['ดอกไม้'] },
    sultan: { id: 'sultan', name: 'Karin Sultan', capacity: 60, speed: 192, fuel: 'B', price: '35,000 RD', jobs: ['จี่เหล็ก', 'หมู'] },
    tailgater: { id: 'tailgater', name: 'Obey Tailgater', capacity: 60, speed: 180, fuel: 'A', price: '28,000 RD', jobs: ['จี่เหล็ก'] },
    rebel: { id: 'rebel', name: 'Karin Rebel', capacity: 120, speed: 155, fuel: 'B', price: '22,000 RD', jobs: ['หมู', 'ไม้'] },
    sadler: { id: 'sadler', name: 'Vapid Sadler', capacity: 120, speed: 150, fuel: 'C', price: '26,000 RD', jobs: ['ไม้', 'หมู'] },
    rumpo: { id: 'rumpo', name: 'Bravado Rumpo', capacity: 150, speed: 140, fuel: 'C', price: '30,000 RD', jobs: ['ไม้', 'หมู', 'ดอกไม้'] },
    speedo: { id: 'speedo', name: 'Vapid Speedo', capacity: 150, speed: 135, fuel: 'B', price: '900 RD/วัน', jobs: ['ไม้', 'หมู'] },
  };

  let vehAbort: AbortController | null = null;

  function setupVehicleShowroom() {
    if (vehAbort) vehAbort.abort();
    vehAbort = new AbortController();
    const { signal } = vehAbort;

    let selectedVehs: string[] = [];
    const tabBtns = document.querySelectorAll('.veh-tab-btn');
    const cards = document.querySelectorAll('.veh-card');
    const compareBtns = document.querySelectorAll('.veh-compare-btn');
    const drawer = document.getElementById('vehCompareDrawer');
    const compareCount = document.getElementById('vehCompareCount');
    const compareContent = document.getElementById('vehCompareContent');
    const clearBtn = document.getElementById('vehClearCompare');

    if (!tabBtns.length && !compareBtns.length) return;

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('border-mint', 'bg-mint', 'text-slate-950', 'font-bold', 'active');
          b.classList.add('border-line', 'bg-card', 'text-textSoft');
        });
        btn.classList.remove('border-line', 'bg-card', 'text-textSoft');
        btn.classList.add('border-mint', 'bg-mint', 'text-slate-950', 'font-bold', 'active');

        const cat = parseInt(btn.getAttribute('data-filter') || '0', 10);
        cards.forEach((card) => {
          const cCat = parseInt(card.getAttribute('data-cat') || '0', 10);
          (card as HTMLElement).style.display = cat === 0 || cCat === cat ? 'flex' : 'none';
        });
      }, { signal });
    });

    function makeCell(text: string, cls: string): HTMLTableCellElement {
      const td = document.createElement('td');
      td.className = cls;
      td.textContent = text;
      return td;
    }

    function updateCompareUI() {
      if (compareCount) compareCount.textContent = String(selectedVehs.length);

      compareBtns.forEach((btn) => {
        const id = btn.getAttribute('data-id') || '';
        const isSel = selectedVehs.includes(id);
        const label = document.createElement('span');
        if (isSel) {
          btn.className = 'veh-compare-btn mt-5 inline-flex items-center justify-center gap-1.5 rounded-xl border border-amber-400 bg-amber-400 text-slate-950 px-4 py-2 text-xs font-mono font-bold transition-all';
          label.textContent = '✓ เลือกแล้ว';
        } else {
          btn.className = 'veh-compare-btn mt-5 inline-flex items-center justify-center gap-1.5 rounded-xl border border-line bg-paper/60 px-4 py-2 text-xs font-mono font-semibold text-white transition-all hover:border-mint hover:text-mint';
          label.textContent = '+ เพิ่มเพื่อเปรียบเทียบ';
        }
        btn.replaceChildren(label);
      });

      if (!drawer || !compareContent) return;
      if (selectedVehs.length === 0) {
        drawer.classList.add('hidden');
        compareContent.replaceChildren();
        return;
      }

      drawer.classList.remove('hidden');
      if (selectedVehs.length === 1) {
        const v = vehiclesData[selectedVehs[0]];
        const p = document.createElement('p');
        p.className = 'text-xs text-textSoft font-mono py-2';
        const strong = document.createElement('strong');
        strong.className = 'text-white';
        strong.textContent = v?.name || '';
        p.append('เลือกแล้ว ', strong, ' · โปรดเลือกอีก 1 คันเพื่อเปรียบเทียบสเปกคู่');
        compareContent.replaceChildren(p);
        return;
      }

      const a = vehiclesData[selectedVehs[0]];
      const b = vehiclesData[selectedVehs[1]];
      if (!a || !b) return;

      const wrap = document.createElement('div');
      wrap.className = 'overflow-x-auto';
      const table = document.createElement('table');
      table.className = 'w-full text-xs font-mono';

      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      headRow.className = 'text-left text-textMuted border-b border-lineSubtle';
      ['คุณสมบัติ', a.name, b.name].forEach((txt, idx) => {
        const th = document.createElement('th');
        th.className = idx === 0 ? 'py-1.5' : 'py-1.5 text-white font-bold';
        th.textContent = txt;
        headRow.appendChild(th);
      });
      thead.appendChild(headRow);

      const tbody = document.createElement('tbody');
      tbody.className = 'divide-y divide-lineSubtle';
      const rows: Array<[string, string, string, string, string]> = [
        [
          'ความจุท้ายรถ',
          `${a.capacity} kg`,
          a.capacity >= b.capacity ? 'py-1.5 text-mint font-bold' : 'py-1.5 text-slate-300',
          `${b.capacity} kg`,
          b.capacity >= a.capacity ? 'py-1.5 text-mint font-bold' : 'py-1.5 text-slate-300',
        ],
        [
          'ความเร็วสูงสุด',
          `${a.speed} km/h`,
          a.speed >= b.speed ? 'py-1.5 text-mint font-bold' : 'py-1.5 text-slate-300',
          `${b.speed} km/h`,
          b.speed >= a.speed ? 'py-1.5 text-mint font-bold' : 'py-1.5 text-slate-300',
        ],
        ['เกรดน้ำมัน', `เกรด ${a.fuel}`, 'py-1.5 text-slate-300', `เกรด ${b.fuel}`, 'py-1.5 text-slate-300'],
        ['ราคา', a.price, 'py-1.5 text-amber-300 font-bold', b.price, 'py-1.5 text-amber-300 font-bold'],
        ['งานที่แนะนำ', a.jobs.join(', '), 'py-1.5 text-slate-300', b.jobs.join(', '), 'py-1.5 text-slate-300'],
      ];

      for (const [label, aVal, aCls, bVal, bCls] of rows) {
        const tr = document.createElement('tr');
        tr.appendChild(makeCell(label, 'py-1.5 text-textMuted'));
        tr.appendChild(makeCell(aVal, aCls));
        tr.appendChild(makeCell(bVal, bCls));
        tbody.appendChild(tr);
      }

      table.append(thead, tbody);
      wrap.appendChild(table);
      compareContent.replaceChildren(wrap);
    }

    compareBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id') || '';
        if (selectedVehs.includes(id)) {
          selectedVehs = selectedVehs.filter((x) => x !== id);
        } else {
          selectedVehs = selectedVehs.length >= 2 ? [selectedVehs[1], id] : [...selectedVehs, id];
        }
        updateCompareUI();
      }, { signal });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        selectedVehs = [];
        updateCompareUI();
      }, { signal });
    }
  }

  document.addEventListener('astro:page-load', setupVehicleShowroom);
  document.addEventListener('astro:before-swap', () => {
    if (vehAbort) {
      vehAbort.abort();
      vehAbort = null;
    }
  });
</script>
