---
import CyberIcon from './CyberIcon.astro';
import GuideIcon from './GuideIcon.astro';
import { getCleanTitle } from '../utils/guideHelpers';

interface Props {
  title: string;
  category: string;
  categoryName: string;
  icon?: string;
  iconImage?: string;
  image?: string;
  tool?: string;
  risk?: string;
  vehicleTier?: string;
  itemWeight?: string;
  cooldown?: number;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  icon = 'file-text',
  iconImage,
  image,
  headings = [],
} = Astro.props;

const cleanTitle = getCleanTitle(title);
const h2Headings = headings.filter((h) => h.depth === 2);
---

<!-- Sticky Reading HUD Strip (Ultra-Clean, Minimalist Cyber) -->
<aside 
  id="guideStickyHud" 
  class="sticky top-16 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2.5 bg-[#050b08]/85 backdrop-blur-xl border-b border-lineSubtle/60 shadow-sm transition-all duration-300"
  aria-label="หัวข้อและสารบัญการอ่าน"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    
    <!-- Left: Identity & Clean Full Title -->
    <div class="flex items-center gap-2.5 min-w-0">
      <GuideIcon icon={icon} iconImage={iconImage || image} class="text-base inline-block shrink-0" imgClass="w-5 h-5 object-contain shrink-0" />
      <h2 class="text-xs sm:text-sm font-bold text-white truncate font-display tracking-wide">
        {cleanTitle}
      </h2>
    </div>

    <!-- Right: High-Agency Reading Actions Only (TOC & Calculator Jump) -->
    <div class="flex items-center gap-2 shrink-0 font-mono text-xs">
      
      <!-- Quick Headings Dropdown Jump -->
      {h2Headings.length > 0 && (
        <div class="relative" id="hudSectionDropdownWrapper">
          <button
            type="button"
            id="hudSectionDropdownBtn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-line bg-paper/80 hover:border-mint/50 text-textSoft hover:text-white transition-all text-xs cursor-pointer"
            title="กระโดดไปที่หัวข้อในหน้านี้"
            aria-expanded="false"
          >
            <CyberIcon name="file-text" class="size-3 text-mint shrink-0" />
            <span id="hudActiveHeadingText" class="truncate max-w-[120px] sm:max-w-[200px]">สารบัญ ({h2Headings.length})</span>
            <CyberIcon name="chevron-down" class="size-2.5 text-textMuted shrink-0 transition-transform duration-200 dropdown-chevron" />
          </button>

          <!-- Dropdown Popover Menu -->
          <div 
            id="hudSectionDropdownMenu" 
            class="absolute right-0 top-full mt-2 w-72 sm:w-80 max-h-80 overflow-y-auto rounded-2xl bg-[#09110d]/95 border border-line p-2 shadow-2xl backdrop-blur-2xl hidden z-50 font-mono text-xs space-y-1 custom-scrollbar"
          >
            <div class="px-2.5 py-1.5 text-[10px] text-textMuted uppercase font-bold tracking-wider border-b border-lineSubtle mb-1 flex items-center justify-between">
              <span>หัวข้อในหน้านี้ (Quick Jump)</span>
              <span class="text-mint font-mono">{h2Headings.length} ส่วน</span>
            </div>
            {h2Headings.map((h, i) => (
              <a
                href={`#${h.slug}`}
                class="hud-heading-link flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-textSoft hover:text-white hover:bg-cardHover text-[11px] transition-colors truncate"
                data-slug={h.slug}
              >
                <span class="text-mint/60 font-bold text-[10px] shrink-0">{i + 1}.</span>
                <span class="truncate">{h.text}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Quick Calculator / ROI Button (Clean glowing accent, hidden if no calc on page) -->
      <button 
        type="button" 
        id="hudQuickCalcBtn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-mint/40 bg-mint/10 text-mint hover:bg-mint/20 hover:border-mint transition-all font-bold text-xs cursor-pointer hidden"
        title="สลับไปแท็บคำนวณกำไร & ค่าเที่ยว"
      >
        <CyberIcon name="zap" class="size-3 text-mint" />
        <span>คำนวณกำไร</span>
      </button>

    </div>

  </div>

  <!-- Micro Reading Progress Bar at the bottom edge -->
  <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-white/5 pointer-events-none">
    <div id="hudReadingProgressBar" class="h-full bg-gradient-to-r from-mint via-emerald-400 to-lime w-0 transition-all duration-100 shadow-[0_0_8px_rgba(69,242,180,0.5)]"></div>
  </div>
</aside>

<script>
  function initHud() {
    const calcBtn = document.getElementById('hudQuickCalcBtn');
    const dropdownBtn = document.getElementById('hudSectionDropdownBtn');
    const dropdownMenu = document.getElementById('hudSectionDropdownMenu');
    const chevron = dropdownBtn?.querySelector('.dropdown-chevron');
    const activeText = document.getElementById('hudActiveHeadingText');
    const headingLinks = document.querySelectorAll('.hud-heading-link');
    const progressBar = document.getElementById('hudReadingProgressBar');

    // Dynamically show calculator button only if calculator/tab exists on this page
    if (calcBtn) {
      const hasCalc = document.getElementById('btnTabCalc') || 
                      document.getElementById('hqCalculatorApp') || 
                      document.querySelector('.job-estimator-card') ||
                      document.getElementById('calculator');
      if (hasCalc) {
        calcBtn.classList.remove('hidden');
        calcBtn.onclick = () => {
          const tabCalc = document.getElementById('btnTabCalc');
          if (tabCalc) {
            tabCalc.click();
          }
          setTimeout(() => {
            const estimator = document.getElementById('hqCalculatorApp') || 
                              document.querySelector('.job-estimator-card') || 
                              document.getElementById('calculator') ||
                              document.getElementById('slotContentCalc');
            if (estimator) {
              estimator.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }, 60);
        };
      } else {
        calcBtn.classList.add('hidden');
      }
    }

    // Section Dropdown Toggle
    if (dropdownBtn && dropdownMenu) {
      dropdownBtn.onclick = (e) => {
        e.stopPropagation();
        const isOpen = !dropdownMenu.classList.contains('hidden');
        if (isOpen) {
          dropdownMenu.classList.add('hidden');
          dropdownBtn.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.classList.remove('rotate-180');
        } else {
          dropdownMenu.classList.remove('hidden');
          dropdownBtn.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.classList.add('rotate-180');
        }
      };

      // Close on outside click (bind once globally)
      if (!(window as any).__hudOutsideClickBound) {
        (window as any).__hudOutsideClickBound = true;
        document.addEventListener('click', (e) => {
          const m = document.getElementById('hudSectionDropdownMenu');
          const b = document.getElementById('hudSectionDropdownBtn');
          const ch = b?.querySelector('.dropdown-chevron');
          if (m && b && !m.contains(e.target as Node) && !b.contains(e.target as Node)) {
            m.classList.add('hidden');
            b.setAttribute('aria-expanded', 'false');
            if (ch) ch.classList.remove('rotate-180');
          }
        });
      }

      // Smooth jump on link click
      headingLinks.forEach((link) => {
        link.addEventListener('click', () => {
          dropdownMenu.classList.add('hidden');
          dropdownBtn.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.classList.remove('rotate-180');
        });
      });
    }

    // ScrollSpy to highlight active heading
    if ((window as any).__hudObserver) {
      (window as any).__hudObserver.disconnect();
    }

    const headings = Array.from(document.querySelectorAll('article h2[id]')) as HTMLElement[];
    if (headings.length > 0 && activeText) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              const text = entry.target.textContent?.trim().replace(/^[0-9.]+\s*/, '') || '';
              if (text) {
                activeText.textContent = text.length > 18 ? text.slice(0, 16) + '...' : text;
              }
              headingLinks.forEach((l) => {
                const slug = l.getAttribute('data-slug');
                if (slug === id) {
                  l.classList.add('bg-mint/15', 'text-mint', 'font-bold');
                } else {
                  l.classList.remove('bg-mint/15', 'text-mint', 'font-bold');
                }
              });
            }
          });
        },
        { rootMargin: '-80px 0px -60% 0px' }
      );

      headings.forEach((h) => observer.observe(h));
      (window as any).__hudObserver = observer;
    }

    // Micro Reading Progress Bar
    if (progressBar) {
      if ((window as any).__hudScrollHandler) {
        window.removeEventListener('scroll', (window as any).__hudScrollHandler);
      }
      const updateProgress = () => {
        const article = document.querySelector('article');
        if (!article) return;
        const rect = article.getBoundingClientRect();
        const totalHeight = rect.height - window.innerHeight;
        if (totalHeight <= 0) {
          progressBar.style.width = '100%';
          return;
        }
        const currentProgress = Math.min(100, Math.max(0, (-rect.top / totalHeight) * 100));
        progressBar.style.width = `${currentProgress}%`;
      };
      (window as any).__hudScrollHandler = updateProgress;
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  }

  initHud();
  document.addEventListener('astro:page-load', initHud);
</script>

<style>
  #hudSectionDropdownMenu:not(.hidden) {
    animation: hudPopoverIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: top right;
  }
  @keyframes hudPopoverIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>
