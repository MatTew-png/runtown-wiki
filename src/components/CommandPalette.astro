---
import { getCollection } from 'astro:content';
import GuideIcon from './GuideIcon.astro';
import CyberIcon from './CyberIcon.astro';
import { getCleanTitle } from '../utils/guideHelpers';

const allGuides = await getCollection('guides');
---

<!-- Global Command Palette (⌘K / Ctrl+K) Modal -->
<div 
  id="commandPaletteModal" 
  class="fixed inset-0 z-50 flex items-start justify-center pt-16 sm:pt-24 px-4 bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="commandPaletteTitle"
>
  <div 
    id="commandPalettePanel"
    class="w-full max-w-2xl rounded-2xl border border-dashed border-mint/40 bg-[#0d1410] shadow-[0_0_50px_rgba(69,242,180,0.15)] overflow-hidden scale-95 transition-all duration-200 flex flex-col max-h-[75vh]"
  >
    <!-- Search Input Header -->
    <div class="p-3.5 border-b border-line flex items-center gap-3 bg-paper">
      <CyberIcon name="search" class="size-4 text-mint shrink-0" />
      <input 
        type="text" 
        id="commandSearchInput" 
        placeholder="พิมพ์ค้นหา... งานขาว, งานดำ, รถ, อาวุธ, ค่าสมอง (หรือกด Esc เพื่อปิด)" 
        class="flex-1 bg-transparent border-none text-white text-sm font-mono placeholder-textMuted focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-card border border-line text-[10px] font-mono text-textMuted font-bold">
        ESC
      </kbd>
    </div>

    <!-- Results Container -->
    <div class="overflow-y-auto p-3 space-y-4 flex-1 divide-y divide-lineSubtle">
      
      <!-- Quick Categories -->
      <div class="pt-1">
        <span class="text-[10px] font-mono font-bold uppercase text-mint tracking-wider px-2 block mb-2">
          // หมวดหมู่ลัด (QUICK SHORTCUTS)
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 font-mono text-xs">
          <a href="/guides/jobs/white" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-mint/15 hover:border-mint/50 border border-line text-slate-200 hover:text-white transition-all">
            <CyberIcon name="briefcase" class="size-4 text-mint shrink-0" />
            <span>งานขาว (7 งาน)</span>
          </a>
          <a href="/guides/jobs/black" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-danger/15 hover:border-danger/50 border border-line text-slate-200 hover:text-white transition-all">
            <CyberIcon name="skull" class="size-4 text-danger shrink-0" />
            <span>งานดำ (4 งาน)</span>
          </a>
          <a href="/guides/logistics/vehicles" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-amber-400/15 hover:border-amber-400/50 border border-line text-slate-200 hover:text-white transition-all">
            <CyberIcon name="truck" class="size-4 text-amber-400 shrink-0" />
            <span>ยานพาหนะ (60/120/150)</span>
          </a>
          <a href="/guides/crafting/weapons" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-lime/15 hover:border-lime/50 border border-line text-slate-200 hover:text-white transition-all">
            <CyberIcon name="swords" class="size-4 text-lime shrink-0" />
            <span>คราฟต์อาวุธ</span>
          </a>
          <a href="/guides/survival/vitals" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-purple-500/15 hover:border-purple-500/50 border border-line text-slate-200 hover:text-white transition-all">
            <CyberIcon name="brain" class="size-4 text-purple-400 shrink-0" />
            <span>ค่าสมอง & รีหัว (บาร์เขียว/อู่ช่าง)</span>
          </a>
          <a href="/guides/gang/headquarter" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-amber-400/15 hover:border-amber-400/50 border border-line text-slate-200 hover:text-white transition-all">
            <img src="/items/icons/transparent/hq_coin.png" class="size-4 object-contain shrink-0" alt="HQ Coin" />
            <span>ระบบแก๊ง (Headquarter)</span>
          </a>
          <a href="/guides/gang/store-robbery" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-rose-500/15 hover:border-rose-500/50 border border-line text-slate-200 hover:text-white transition-all">
            <img src="/items/icons/transparent/breaching_kit.png" class="size-4 object-contain shrink-0" alt="Breaching Kit" />
            <span>งัดร้านค้า (Store Robbery)</span>
          </a>
          <a href="/guides/food/nutrition" class="palette-item flex items-center gap-2 p-2 rounded-xl bg-card hover:bg-mint/15 hover:border-mint/50 border border-line text-slate-200 hover:text-white transition-all">
            <CyberIcon name="drumstick" class="size-4 text-cyan-300 shrink-0" />
            <span>อาหาร & เสบียง</span>
          </a>
        </div>
      </div>

      <!-- All Guides List -->
      <div class="pt-3">
        <span class="text-[10px] font-mono font-bold uppercase text-textMuted tracking-wider px-2 block mb-2" id="resultsCountHeader">
          // รายการคู่มือทั้งหมด ({allGuides.length} บทความ)
        </span>
        <ul class="space-y-1 font-mono text-xs" id="paletteResultsList">
          {allGuides.map((guide) => (
            <li class="palette-guide-entry" data-title={guide.data.title.toLowerCase()} data-desc={guide.data.description.toLowerCase()} data-cat={guide.data.categoryName.toLowerCase()}>
              <a 
                href={`/guides/${guide.slug}`} 
                class="flex items-start justify-between gap-3 p-2.5 rounded-xl hover:bg-cardHover border border-transparent hover:border-line group transition-all"
              >
                <div class="flex items-start gap-2.5 min-w-0">
                  <GuideIcon icon={guide.data.icon} iconImage={guide.data.iconImage || guide.data.image} class="text-base shrink-0 mt-0.5" imgClass="w-4 h-4 object-contain shrink-0 mt-0.5" />
                  <div>
                    <h4 class="text-white font-bold group-hover:text-mint transition-colors text-xs flex items-center gap-2">
                      <span>{getCleanTitle(guide.data.title)}</span>
                      <span class="text-[9px] px-1.5 py-0.2 rounded bg-paper border border-line text-textMuted font-mono">
                        {guide.data.categoryName}
                      </span>
                    </h4>
                    <p class="text-[11px] text-textMuted line-clamp-1 mt-0.5 font-sans">
                      {guide.data.description}
                    </p>
                  </div>
                </div>
                <span class="text-mint opacity-0 group-hover:opacity-100 transition-opacity shrink-0 text-xs">
                  ➔
                </span>
              </a>
            </li>
          ))}
        </ul>

        <!-- Empty State -->
        <div id="paletteEmptyState" class="hidden py-8 text-center space-y-2">
          <CyberIcon name="search" class="size-8 mx-auto text-textMuted" />
          <p class="text-xs font-mono text-textMuted">ไม่พบคู่มือที่ตรงกับคำค้นหา ลองค้นคำอื่น เช่น "หมู", "รถ", "กัญชา", "เหล็ก"</p>
        </div>
      </div>

    </div>

    <!-- Footer Controls -->
    <div class="p-2.5 px-4 bg-paper border-t border-lineSubtle flex items-center justify-between text-[11px] font-mono text-textMuted">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <kbd class="px-1 py-0.5 rounded bg-card border border-line text-[9px]">↵</kbd> เพื่อเลือก
        </span>
        <span class="flex items-center gap-1">
          <kbd class="px-1 py-0.5 rounded bg-card border border-line text-[9px]">ESC</kbd> เพื่อปิด
        </span>
      </div>
      <span class="text-mint font-bold">RUN TOWN COMMAND ⌘K</span>
    </div>
  </div>
</div>

<script>
  function setupCommandPalette() {
    const modal = document.getElementById('commandPaletteModal');
    const panel = document.getElementById('commandPalettePanel');
    const input = document.getElementById('commandSearchInput') as HTMLInputElement;
    const entries = document.querySelectorAll('.palette-guide-entry');
    const emptyState = document.getElementById('paletteEmptyState');
    const resultsHeader = document.getElementById('resultsCountHeader');

    function openPalette() {
      if (!modal || !panel || !input) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('scale-95');
      panel.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 50);
    }

    function closePalette() {
      if (!modal || !panel || !input) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('scale-100');
      panel.classList.add('scale-95');
      document.body.style.overflow = '';
      input.value = '';
      filterResults('');
    }

    function filterResults(query: string) {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;

      entries.forEach((entry) => {
        const el = entry as HTMLElement;
        const title = el.getAttribute('data-title') || '';
        const desc = el.getAttribute('data-desc') || '';
        const cat = el.getAttribute('data-cat') || '';

        if (!q || title.includes(q) || desc.includes(q) || cat.includes(q)) {
          el.style.display = '';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
      if (resultsHeader) {
        resultsHeader.textContent = q 
          ? `// ผลการค้นหา (${visibleCount} บทความ)`
          : `// รายการคู่มือทั้งหมด (${entries.length} บทความ)`;
      }
    }

    // Keyboard Shortcuts: Ctrl+K or Cmd+K
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal?.classList.contains('opacity-0')) {
          openPalette();
        } else {
          closePalette();
        }
      } else if (e.key === 'Escape' && !modal?.classList.contains('opacity-0')) {
        closePalette();
      }
    });

    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closePalette();
      });
    }

    // Input filter event
    if (input) {
      input.addEventListener('input', (e) => {
        filterResults((e.target as HTMLInputElement).value);
      });
    }

    // Connect any global trigger buttons
    document.querySelectorAll('.open-command-palette-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openPalette();
      });
    });
  }

  // Run on initial load and after view transitions
  setupCommandPalette();
  document.addEventListener('astro:page-load', setupCommandPalette);
</script>
