---
// Generative Geometric Background Engine inspired by https://bookofshapes.com/
// Features 4 mathematical generative patterns:
// 1. Deformed Grid & Interference Mesh (deformed_grid_mesh / interference_mesh)
// 2. Wave Field & Joy Division Flow (wave_field / flow_lines)
// 3. Node Garden Constellation (node_garden / physics)
// 4. Isometric Hexagonal Strands (hex_strands / iso-cross)
---

<div id="generative-shapes-container" class="fixed inset-0 pointer-events-none -z-10 overflow-hidden select-none bg-[#050806]">
  <!-- Interactive Fullscreen HTML5 2D Canvas -->
  <canvas id="generative-shapes-canvas" class="w-full h-full block opacity-85"></canvas>
  
  <!-- Ambient Vignette & Deep Radial Gradients for Contrast Protection -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#050806] via-transparent to-[#050806]/80 pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_40%,_#050806_95%)] pointer-events-none"></div>
</div>

<!-- Background runs permanently without floating control pill -->

<script>
  interface PatternMode {
    id: string;
    name: string;
  }

  const PATTERNS: PatternMode[] = [
    { id: 'node_garden', name: 'NODE GARDEN' },
    { id: 'deformed_mesh', name: 'DEFORMED MESH' },
    { id: 'wave_field', name: 'FLOW WAVES' },
    { id: 'hex_strands', name: 'HEX STRANDS' },
  ];

  let currentPatternIndex = 0;
  let isPaused = false;
  let seedOffset = Math.random() * 1000;

  // Node Garden state
  interface NodeParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
  }
  let nodes: NodeParticle[] = [];

  function initGenerativeShapes() {
    const canvas = document.getElementById('generative-shapes-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Load saved pattern preference (Default is Node Garden)
    const saved = localStorage.getItem('run_town_bg_pattern');
    if (saved && saved !== 'deformed_mesh') {
      const idx = PATTERNS.findIndex(p => p.id === saved);
      if (idx !== -1) currentPatternIndex = idx;
    } else {
      currentPatternIndex = 0; // Set to Node Garden by default
      localStorage.setItem('run_town_bg_pattern', 'node_garden');
    }

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resize() {
      if (!canvas || !ctx) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
      initNodes();
    }

    // Initialize node garden particles
    function initNodes() {
      const count = Math.min(95, Math.max(45, Math.floor((width * height) / 19000)));
      nodes = [];
      const colors = ['#45f2b4', '#a5ff5f', '#fbbf24', '#38bdf8', '#ffffff'];
      for (let i = 0; i < count; i++) {
        nodes.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          radius: Math.random() * 2 + 1.2,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // Mouse Tracking with smooth lerp
    const mouse = {
      x: width * 0.5,
      y: height * 0.5,
      targetX: width * 0.5,
      targetY: height * 0.5,
      isHovered: false,
    };

    window.addEventListener('mousemove', (e) => {
      mouse.targetX = e.clientX;
      mouse.targetY = e.clientY;
      mouse.isHovered = true;
    }, { passive: true });

    window.addEventListener('mouseleave', () => {
      mouse.isHovered = false;
      mouse.targetX = width * 0.5;
      mouse.targetY = height * 0.5;
    });

    let animationFrameId: number;
    let time = 0;

    // Pattern 1: Deformed Grid Mesh & Interference Moiré (Signature Book of Shapes)
    function drawDeformedMesh(t: number) {
      if (!ctx) return;
      const spacingX = Math.max(38, width / 36);
      const spacingY = Math.max(38, height / 24);

      ctx.lineWidth = 1;

      // Horizontal Lines
      for (let y = 0; y <= height + spacingY; y += spacingY) {
        ctx.beginPath();
        let isFirst = true;

        for (let x = 0; x <= width + spacingX; x += 18) {
          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const dist = Math.hypot(dx, dy);
          const mouseWeight = Math.max(0, 1 - dist / 320);
          const mouseOffset = Math.sin(mouseWeight * Math.PI) * 42;

          const wave = Math.sin(x * 0.004 + t * 0.0012 + seedOffset) * 16 +
                       Math.cos(y * 0.005 + t * 0.0009) * 12;

          const px = x;
          const py = y + wave + (dy < 0 ? -mouseOffset : mouseOffset) * 0.4;

          if (isFirst) {
            ctx.moveTo(px, py);
            isFirst = false;
          } else {
            ctx.lineTo(px, py);
          }
        }

        ctx.strokeStyle = `rgba(69, 242, 180, ${0.06 + Math.sin(y * 0.01 + t * 0.001) * 0.025})`;
        ctx.stroke();
      }

      // Vertical Lines (creates interference Moiré lattice)
      for (let x = 0; x <= width + spacingX; x += spacingX) {
        ctx.beginPath();
        let isFirst = true;

        for (let y = 0; y <= height + spacingY; y += 18) {
          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const dist = Math.hypot(dx, dy);
          const mouseWeight = Math.max(0, 1 - dist / 320);
          const mouseOffset = Math.sin(mouseWeight * Math.PI) * 42;

          const wave = Math.cos(x * 0.005 + t * 0.001 + seedOffset) * 14 +
                       Math.sin(y * 0.004 + t * 0.0013) * 14;

          const px = x + (dx < 0 ? -mouseOffset : mouseOffset) * 0.4;
          const py = y + wave;

          if (isFirst) {
            ctx.moveTo(px, py);
            isFirst = false;
          } else {
            ctx.lineTo(px, py);
          }
        }

        ctx.strokeStyle = `rgba(165, 255, 95, ${0.05 + Math.cos(x * 0.01 + t * 0.001) * 0.02})`;
        ctx.stroke();
      }
    }

    // Pattern 2: Flow Waves / Joy Division Elevation Lines (Book of Shapes wave_field)
    function drawWaveField(t: number) {
      if (!ctx) return;
      const numLines = Math.min(38, Math.floor(height / 28));
      const stepY = height / (numLines + 1);

      ctx.lineWidth = 1.3;

      for (let i = 1; i <= numLines; i++) {
        const baseY = i * stepY;
        ctx.beginPath();
        let isFirst = true;

        for (let x = 0; x <= width + 20; x += 14) {
          const dx = x - mouse.x;
          const dy = baseY - mouse.y;
          const dist = Math.hypot(dx, dy);
          const mouseWeight = Math.exp(-Math.pow(dist / 220, 2)) * 65;

          const wave = Math.sin(x * 0.0045 + t * 0.0015 + i * 0.18 + seedOffset) * 18 +
                       Math.cos(x * 0.009 + t * 0.0008) * 9;

          const py = baseY + wave - mouseWeight;

          if (isFirst) {
            ctx.moveTo(x, py);
            isFirst = false;
          } else {
            ctx.lineTo(x, py);
          }
        }

        const alpha = 0.07 + (i / numLines) * 0.08;
        ctx.strokeStyle = i % 4 === 0 
          ? `rgba(251, 191, 36, ${alpha * 1.1})` 
          : `rgba(69, 242, 180, ${alpha})`;
        ctx.stroke();
      }
    }

    // Pattern: Node Garden Constellation (Book of Shapes node_garden)
    function drawNodeGarden(t: number) {
      if (!ctx) return;
      const maxDist = 160;

      // Update positions
      for (const node of nodes) {
        node.x += node.vx;
        node.y += node.vy;

        // Wrap around bounds
        if (node.x < 0) node.x = width;
        if (node.x > width) node.x = 0;
        if (node.y < 0) node.y = height;
        if (node.y > height) node.y = 0;

        // Mouse slight gravitation
        const dx = mouse.x - node.x;
        const dy = mouse.y - node.y;
        const dist = Math.hypot(dx, dy);
        if (dist < 220 && dist > 10) {
          node.x += (dx / dist) * 0.35;
          node.y += (dy / dist) * 0.35;
        }

        // Draw node
        ctx.beginPath();
        ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
        ctx.fillStyle = node.color;
        ctx.globalAlpha = 0.65;
        ctx.fill();
        ctx.globalAlpha = 1.0;
      }

      // Draw connective lines between nearby nodes
      ctx.lineWidth = 0.9;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.hypot(dx, dy);

          if (dist < maxDist) {
            const alpha = (1 - dist / maxDist) * 0.22;
            ctx.strokeStyle = `rgba(69, 242, 180, ${alpha})`;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }

        // Connect with cursor
        const dMouse = Math.hypot(nodes[i].x - mouse.x, nodes[i].y - mouse.y);
        if (dMouse < 200) {
          const alpha = (1 - dMouse / 200) * 0.45;
          ctx.strokeStyle = `rgba(165, 255, 95, ${alpha})`;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.stroke();
        }
      }

      // Cursor attractor micro dot
      if (mouse.isHovered) {
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = '#45f2b4';
        ctx.globalAlpha = 0.7;
        ctx.fill();
        ctx.globalAlpha = 1.0;
      }
    }

    // Pattern 4: Isometric Hex Strands & Cross Lattice (Book of Shapes hex_strands / iso-cross)
    function drawHexStrands(t: number) {
      if (!ctx) return;
      const size = Math.max(48, width / 28);
      const h = size * Math.sin(Math.PI / 3);

      ctx.lineWidth = 1;

      for (let row = -1; row * h <= height + h * 2; row++) {
        const y = row * h;
        const xOffset = (row % 2) * (size * 1.5);

        for (let x = -size * 2; x <= width + size * 2; x += size * 3) {
          const cx = x + xOffset;
          const cy = y;

          const dx = cx - mouse.x;
          const dy = cy - mouse.y;
          const dist = Math.hypot(dx, dy);
          const mouseScale = Math.max(0, 1 - dist / 260) * 8;

          const wave = Math.sin((cx + cy) * 0.005 + t * 0.0012 + seedOffset) * 6;
          const radius = (size * 0.48) + wave + mouseScale;

          // Draw isometric hexagon
          ctx.beginPath();
          for (let a = 0; a < 6; a++) {
            const angle = (a * Math.PI) / 3 + (t * 0.0003);
            const px = cx + Math.cos(angle) * radius;
            const py = cy + Math.sin(angle) * radius;
            if (a === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.closePath();

          const alpha = 0.06 + Math.sin(cx * 0.01 + t * 0.001) * 0.03;
          ctx.strokeStyle = (row + Math.floor(x / size)) % 3 === 0 
            ? `rgba(251, 191, 36, ${alpha})`
            : `rgba(69, 242, 180, ${alpha})`;
          ctx.stroke();

          // Center micro dot
          ctx.beginPath();
          ctx.arc(cx, cy, 1.2, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.25)';
          ctx.fill();
        }
      }
    }

    // Main 60fps render loop
    function render(timestamp: number) {
      if (!ctx || !canvas) return;

      if (!isPaused) {
        time = timestamp;
        // Smooth cursor lerping
        mouse.x += (mouse.targetX - mouse.x) * 0.06;
        mouse.y += (mouse.targetY - mouse.y) * 0.06;

        ctx.clearRect(0, 0, width, height);

        const currentPattern = PATTERNS[currentPatternIndex].id;
        if (currentPattern === 'deformed_mesh') {
          drawDeformedMesh(time);
        } else if (currentPattern === 'wave_field') {
          drawWaveField(time);
        } else if (currentPattern === 'node_garden') {
          drawNodeGarden(time);
        } else if (currentPattern === 'hex_strands') {
          drawHexStrands(time);
        }
      }

      animationFrameId = requestAnimationFrame(render);
    }

    animationFrameId = requestAnimationFrame(render);

    // Update UI HUD Text
    function updateHUD() {
      const nameDisp = document.getElementById('shapes-name-display');
      if (nameDisp) {
        nameDisp.textContent = PATTERNS[currentPatternIndex].name;
      }
      localStorage.setItem('run_town_bg_pattern', PATTERNS[currentPatternIndex].id);
    }

    // Cycle pattern button handler
    const cycleBtn = document.getElementById('shapes-cycle-btn');
    cycleBtn?.addEventListener('click', () => {
      currentPatternIndex = (currentPatternIndex + 1) % PATTERNS.length;
      updateHUD();
      if (PATTERNS[currentPatternIndex].id === 'node_garden') initNodes();
    });

    // Randomize seed button handler
    const randomBtn = document.getElementById('shapes-random-btn');
    randomBtn?.addEventListener('click', () => {
      seedOffset = Math.random() * 5000;
      initNodes();
    });

    // Pause / Play button handler
    const toggleBtn = document.getElementById('shapes-toggle-btn');
    const toggleIcon = document.getElementById('shapes-toggle-icon');
    toggleBtn?.addEventListener('click', () => {
      isPaused = !isPaused;
      if (toggleIcon) toggleIcon.textContent = isPaused ? '▶️' : '⏸️';
    });

    updateHUD();

    // Cleanup on page swap (Astro View Transitions)
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener('resize', resize);
    }, { once: true });
  }

  // Initialize on direct load & client router page load
  initGenerativeShapes();
  document.addEventListener('astro:page-load', () => {
    initGenerativeShapes();
  });
</script>
