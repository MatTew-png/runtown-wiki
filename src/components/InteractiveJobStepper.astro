          { num: '01', name: 'ย่างเนื้อ Doner & ปิ้งแป้ง (สาขา Downtown / Legion)', en: 'ROAST MEAT & TOAST BREAD', desc: 'หยิบเนื้อจากตู้แช่ราคา 2,500 RD (TAKE DONER SPLIT) วางบนเตาย่าง (PLACE SPLIT) ย่าง 3 นาที ทำได้พร้อมกัน 2 เครื่อง (1 ก้อนทำได้ 4 ชิ้น) และปิ้งแป้งโดยใช้ Rice Grain x2', tool: 'ตู้แช่เนื้อ 2,500 RD + เตา Doner 2 เครื่อง', duration: 'ย่างเนื้อ 3 นาที (ได้ 4 ชิ้น)', weight: '0.30 กก. / ชิ้น', output: 'เนื้อย่างสุก 1 ก้อน (4 ชิ้น) + แป้งปิ้งสุก', coords: 'ร้านอาหาร Run Kitchen (สาขา Downtown / Legion)', spotId: 'kitchen-downtown', image: '/maps/spots/kitchen_cook.png' },
          { num: '02', name: 'หั่นเนื้อ & ประกอบ Kebab/Pita (สาขา Vespucci)', en: 'SHAVE DONER & ASSEMBLE', desc: 'หยิบแป้งที่ปิ้งเสร็จ (TAKE BREAD) เดินไปที่เสาเนื้อย่าง เลือก SHAVE DONER แล้วเลือก ADD DONER KEBAB เพื่อใส่เนื้อลงในแป้ง จากนั้นกด E เพื่อเสร็จสิ้นขั้นตอน (ห้ามออกนอกร้านระหว่างทำ)', tool: 'มีดสไลด์ Shave Doner + แป้ง Wrap', duration: 'ทันที (กด E)', weight: '0.30 กก. / ชิ้น', output: 'Kebab หรือ Pita 1 ชิ้น (ลดหิว 50% เครียด -10)', coords: 'เคาน์เตอร์ประกอบอาหาร Run Kitchen (สาขา Vespucci)', spotId: 'kitchen-vespucci', image: '/maps/spots/kitchen_assemble.png' },
          { num: '03', name: 'เปิดแอป รันแมน รับออเดอร์ (สาขา Mirror Park)', en: 'ACCEPT RUNMAN ORDER', desc: 'เปิดโทรศัพท์ > แอป รันแมน > บัญชี > เข้า Runner Mode > เปิดส่งอาหาร ระบบจะสุ่ม NPC ออเดอร์ Kebab จำนวน 2-4 ชิ้น (NPC รับซื้อเฉพาะ Kebab เท่านั้น! ห้ามกดยกเลิก ไม่งั้นติดคูลดาวน์ 15 นาที)', tool: 'สมาร์ทโฟน > แอป รันแมน (Runner Mode)', duration: 'สุ่มเรียกงาน (คูลดาวน์ 3-5 นาที)', weight: '-', output: 'ออเดอร์ส่งอาหาร 2 - 4 ชิ้น', coords: 'แอป รันแมน (สาขา Mirror Park / ทั่วเมือง)', spotId: 'kitchen-mirror', image: '/maps/spots/kitchen_app.png' },
          { num: '04', name: 'บิดส่งลูกค้า NPC รับเงินสด (สาขา Paleto Bay)', en: 'DELIVER FOOD & CASH OUT', desc: 'ขับรถไปยังจุดหมาย คุยกับ NPC เพื่อส่งมอบ Kebab รับเงินสดทันที 1,500 RD ต่อชิ้น (ออเดอร์ละ 3,000 - 6,000 RD!) ลุ้นโบนัส 10% ได้รับงานต่อเนื่องทันทีไม่ต้องรอคูลดาวน์', tool: 'NPC ลูกค้าปลายทาง / รถ 60 กก.', duration: 'ส่งทันที', weight: '-', output: '1,500 RD / ชิ้น (รวม 3,000 - 6,000 RD/จุด)', coords: 'จุดนัดพบ NPC ลูกค้า (สาขา Paleto Bay / ทั่วเมือง)', spotId: 'kitchen-paleto', image: '/maps/spots/kitchen_deliver.png' }
        ]
      }
    };

    const section = document.getElementById('jobStepperSection');
    if (!section) return;

    const initialJobFromAttr = section.getAttribute('data-active-job') || 'wood';
    let currentJob = initialJobFromAttr;
    let currentStep = 0;

    const stageStepBadge = document.getElementById('stageStepBadge');
    const stageEnName = document.getElementById('stageEnName');
    const stageTitle = document.getElementById('stageTitle');
    const stageDesc = document.getElementById('stageDesc');
    const stageCoords = document.getElementById('stageCoords');
    const overlayCoords = document.getElementById('overlayCoords');
    const stageTool = document.getElementById('stageTool');
    const stageDuration = document.getElementById('stageDuration');
    const stageWeight = document.getElementById('stageWeight');
    const stageOutput = document.getElementById('stageOutput');
    const stageImage = document.getElementById('stageImage') as HTMLImageElement;
    const stageLiveMapLink = document.getElementById('stageLiveMapLink') as HTMLAnchorElement;
    const stageQuickRadarBtn = document.getElementById('stageQuickRadarBtn') as HTMLAnchorElement;
    const stageZoomBtn = document.getElementById('stageZoomBtn');

    function renderStage() {
      const jobObj = (jobs as any)[currentJob] || jobs.wood;
      const step = jobObj.steps[currentStep] || jobObj.steps[0];

      if (stageStepBadge) stageStepBadge.textContent = `STEP ${step.num}`;
      if (stageEnName) stageEnName.textContent = step.en;
      if (stageTitle) stageTitle.textContent = step.name;
      if (stageDesc) stageDesc.textContent = step.desc;
      if (stageCoords) stageCoords.textContent = step.coords;
      if (overlayCoords) overlayCoords.textContent = step.coords;
      if (stageTool) stageTool.textContent = step.tool;
      if (stageDuration) stageDuration.textContent = step.duration;
      if (stageWeight) stageWeight.textContent = step.weight;
      if (stageOutput) stageOutput.textContent = step.output;

      if (stageImage) {
        stageImage.src = step.image;
        stageImage.alt = step.name;
        stageImage.setAttribute('data-lightbox-src', step.image);
        stageImage.setAttribute('data-lightbox-title', step.name);
        stageImage.setAttribute('data-lightbox-coords', step.coords);
        stageImage.setAttribute('data-lightbox-spot', step.spotId);
      }

      if (stageLiveMapLink) {
        stageLiveMapLink.href = `/map?spot=${encodeURIComponent(step.spotId)}`;
      }

      if (stageQuickRadarBtn) {
        stageQuickRadarBtn.href = `/map?spot=${encodeURIComponent(step.spotId)}`;
      }

      // Update active state on step buttons & text labels
      document.querySelectorAll('.stepper-step-btn').forEach((btn, idx) => {
        const stepData = jobObj.steps[idx];
        if (stepData) {
          const strong = btn.querySelector('strong');
          if (strong) strong.textContent = `${idx + 1}. ${stepData.name.split('(')[0].trim()}`;
        }

        if (idx === currentStep) {
          btn.className = 'stepper-step-btn active p-3 rounded-xl border border-mint bg-mint/15 text-left transition-all shadow-[0_0_20px_-5px_rgba(69,242,180,0.3)] group';
          const dot = btn.querySelector('.rounded-full');
          if (dot) dot.className = 'size-2 rounded-full bg-mint';
          const txt = btn.querySelector('span');
          if (txt) txt.className = 'text-mint font-bold';
        } else {
          btn.className = 'stepper-step-btn p-3 rounded-xl border border-line bg-card/70 text-left transition-all hover:border-lineSubtle group';
          const dot = btn.querySelector('.rounded-full');
          if (dot) dot.className = 'size-2 rounded-full bg-slate-600';
          const txt = btn.querySelector('span');
          if (txt) txt.className = 'text-slate-200 font-bold';
        }
      });
    }

    // Step button click listeners
    document.querySelectorAll('.stepper-step-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-step-index') || '0', 10);
        if (idx !== currentStep) {
          currentStep = idx;
          const stageCanvas = document.getElementById('stepperStageCanvas');
          if (stageCanvas) {
            stageCanvas.classList.remove('stage-transition-in');
            void stageCanvas.offsetWidth;
            stageCanvas.classList.add('stage-transition-in');
          }
          renderStage();
        }
      });
    });

    // Job tab listeners
    document.querySelectorAll('.stepper-job-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const jobId = tab.getAttribute('data-job-id') || 'wood';
        currentJob = jobId;
        currentStep = 0;

        document.querySelectorAll('.stepper-job-tab').forEach((t) => {
          if (t === tab) {
            t.className = 'stepper-job-tab shrink-0 px-3.5 py-2 rounded-xl border text-xs font-mono transition-all flex items-center gap-2 border-mint bg-mint/15 text-mint font-bold shadow-[0_0_15px_rgba(69,242,180,0.2)] active';
          } else {
            t.className = 'stepper-job-tab shrink-0 px-3.5 py-2 rounded-xl border text-xs font-mono transition-all flex items-center gap-2 border-line bg-card/60 text-slate-200 hover:text-white hover:border-lineSubtle';
          }
        });

        renderStage();
      });
    });

    // Zoom trigger click
    if (stageZoomBtn && stageImage) {
      stageZoomBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        stageImage.click();
      });
    }

    renderStage();
  }

  initJobStepper();
  document.addEventListener('astro:page-load', initJobStepper);
</script>

<style>
  .stage-transition-in {
    animation: stepperStageFade 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes stepperStageFade {
    0% {
      opacity: 0.65;
      transform: translateY(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #stageImage {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }
</style>
