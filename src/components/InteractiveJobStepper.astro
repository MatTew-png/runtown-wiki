  kitchen: {
    id: 'kitchen',
    name: 'งานครัว & ส่งอาหาร',
    en: 'RUN KITCHEN & DELIVERY',
    icon: 'drumstick',
    tone: 'amber',
    steps: [
      {
        num: '01',
        name: 'ย่างเนื้อ Doner & ปิ้งแป้ง (สาขา Downtown / Legion)',
        en: 'ROAST MEAT & TOAST BREAD',
        desc: 'หยิบเนื้อจากตู้แช่ราคา 2,500 RD (เลือก TAKE DONER SPLIT) วางบนเตาย่าง (PLACE SPLIT) ย่าง 3 นาที ทำได้พร้อมกัน 2 เครื่อง (1 ก้อนทำได้ 4 ชิ้น) และปิ้งแป้งโดยใช้ Rice Grain x2',
        tool: 'ตู้แช่เนื้อ 2,500 RD + เตา Doner 2 เครื่อง',
        duration: 'ย่างเนื้อ 3 นาที (ได้ 4 ชิ้น)',
        weight: '0.30 กก. / ชิ้น',
        output: 'เนื้อย่างสุก 1 ก้อน (4 ชิ้น) + แป้งปิ้งสุก',
        coords: 'ร้านอาหาร Run Kitchen (สาขา Downtown / Legion)',
        spotId: 'kitchen-downtown',
        image: '/maps/spots/kitchen_cook.png',
      },
      {
        num: '02',
