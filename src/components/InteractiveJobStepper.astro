const currentJobData = jobsData[activeJobKey] || jobsData.wood;
const initialStep = currentJobData.steps[0];
---

<!-- Interactive 4-Step Pipeline Stepper (Focus Mode Experience) -->
<section class="interactive-job-stepper my-10 space-y-6" id="jobStepperSection" data-active-job={activeJobKey}>
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-3 border-b border-line">
    <div>
      <span class="text-xs font-mono font-bold text-mint uppercase tracking-widest">// INTERACTIVE 4-STEP PIPELINE</span>
      <h3 class="text-xl sm:text-2xl font-display font-extrabold text-white mt-1 flex items-center gap-2">
        <CyberIcon name="zap" class="size-6 text-mint" />
        {showJobSelector ? (
          <span>ผังขั้นตอนการทำงาน (สลับดู 4 สเต็ปในกล่องเดียว)</span>
        ) : (
          <span>ขั้นตอนการทำงาน 4 สเต็ป: {currentJobData.name} ({currentJobData.en})</span>
        )}
      </h3>
    </div>
    <span class="text-xs font-mono text-textMuted">คลิกสเต็ปเพื่อดูอุปกรณ์ จุดสังเกตบนแผนที่ และรูปหน้างาน</span>
  </div>

  <!-- Job Selector Row (If master hub view) -->
  {showJobSelector && (
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="stepperJobTabs">
      {Object.values(jobsData).map((job) => (
        <button
          type="button"
          class={`stepper-job-tab shrink-0 px-3.5 py-2 rounded-xl border text-xs font-mono transition-all flex items-center gap-2 ${
            job.id === activeJobKey
              ? 'border-mint bg-mint/15 text-mint font-bold shadow-[0_0_15px_rgba(69,242,180,0.2)] active'
              : 'border-line bg-card/60 text-slate-200 hover:text-white hover:border-lineSubtle'
          }`}
          data-job-id={job.id}
        >
          <CyberIcon name={job.icon} class="size-3.5" />
          <span>{job.name}</span>
          <span class="text-[10px] text-textMuted font-normal uppercase">({job.en})</span>
        </button>
      ))}
    </div>
  )}

  <!-- Step Pipeline Navigation Buttons -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5" id="stepperStepButtons">
    <button
      type="button"
      class="stepper-step-btn active p-3 rounded-xl border border-mint bg-mint/15 text-left transition-all shadow-[0_0_20px_-5px_rgba(69,242,180,0.3)] group"
      data-step-index="0"
    >
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-mint font-bold">STEP 01</span>
        <span class="size-2 rounded-full bg-mint"></span>
      </div>
      <strong class="text-sm font-bold text-white block mt-1 group-hover:text-mint transition-colors">
        1. {currentJobData.steps[0]?.name.split('(')[0].trim() || 'ฟาร์มของดิบ'}
      </strong>
      <span class="text-[11px] text-textMuted block font-mono">ขั้นตอนที่ 1</span>
    </button>

    <button
      type="button"
      class="stepper-step-btn p-3 rounded-xl border border-line bg-card/70 text-left transition-all hover:border-lineSubtle group"
      data-step-index="1"
    >
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-slate-200 font-bold">STEP 02</span>
        <span class="size-2 rounded-full bg-slate-600"></span>
      </div>
      <strong class="text-sm font-bold text-white block mt-1 group-hover:text-mint transition-colors">
        2. {currentJobData.steps[1]?.name.split('(')[0].trim() || 'แปรรูป (โพล)'}
      </strong>
      <span class="text-[11px] text-textMuted block font-mono">ขั้นตอนที่ 2</span>
    </button>

    <button
      type="button"
      class="stepper-step-btn p-3 rounded-xl border border-line bg-card/70 text-left transition-all hover:border-lineSubtle group"
      data-step-index="2"
    >
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-slate-200 font-bold">STEP 03</span>
        <span class="size-2 rounded-full bg-slate-600"></span>
      </div>
      <strong class="text-sm font-bold text-white block mt-1 group-hover:text-mint transition-colors">
        3. {currentJobData.steps[2]?.name.split('(')[0].trim() || 'แพ็กกล่องสินค้า'}
      </strong>
      <span class="text-[11px] text-textMuted block font-mono">ขั้นตอนที่ 3</span>
    </button>

    <button
      type="button"
      class="stepper-step-btn p-3 rounded-xl border border-line bg-card/70 text-left transition-all hover:border-lineSubtle group"
      data-step-index="3"
    >
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-slate-200 font-bold">STEP 04</span>
        <span class="size-2 rounded-full bg-slate-600"></span>
      </div>
      <strong class="text-sm font-bold text-white block mt-1 group-hover:text-mint transition-colors">
        4. {currentJobData.steps[3]?.name.split('(')[0].trim() || 'ส่งขายรับเงินสด'}
      </strong>
      <span class="text-[11px] text-textMuted block font-mono">ขั้นตอนที่ 4</span>
    </button>
  </div>

  <!-- Active Step Stage Canvas -->
  <div class="rounded-2xl border border-mint/40 bg-card/90 p-5 sm:p-6 backdrop-blur-md shadow-neon-card space-y-6" id="stepperStageCanvas" data-active-job={activeJobKey}>
    
    <!-- Stage Header & Telemetry -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-lineSubtle">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-mint/20 text-mint border border-mint/40 font-bold" id="stageStepBadge">
            STEP {initialStep.num}
          </span>
          <span class="text-xs font-mono text-textMuted" id="stageEnName">
            {initialStep.en}
          </span>
        </div>
        <h4 class="text-xl sm:text-2xl font-display font-extrabold text-white" id="stageTitle">
          {initialStep.name}
        </h4>
        <p class="text-xs sm:text-sm text-textSoft" id="stageDesc">
          {initialStep.desc}
        </p>
      </div>

      <!-- Quick Zone & Radar Box -->
      <div class="p-3 rounded-xl bg-paper border border-line flex items-center justify-between gap-3 font-mono text-xs shrink-0 min-w-[260px]">
        <div>
          <span class="text-[10px] text-textMuted block flex items-center gap-1 font-semibold">
            <CyberIcon name="map-pin" class="size-3 text-mint" />
            ตำแหน่งโซน & จุดสังเกต:
          </span>
          <strong class="text-white text-xs block mt-0.5" id="stageCoords">{initialStep.coords}</strong>
        </div>

        <a
          id="stageQuickRadarBtn"
          href={`/map?spot=${encodeURIComponent(initialStep.spotId)}`}
          class="px-3 py-1.5 rounded-lg border border-mint/40 bg-mint/10 text-mint hover:bg-mint/25 transition-colors font-bold text-xs flex items-center gap-1 shrink-0"
          title="เปิดนำทางบนแผนที่เรดาร์สด"
        >
          <CyberIcon name="map" class="size-3.5 text-mint" />
          <span>เปิดเรดาร์ ➔</span>
        </a>
      </div>
    </div>

    <!-- 4 Specs Matrix -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
      <div class="p-3 rounded-xl bg-paper border border-line">
        <span class="text-textMuted text-[10px] block flex items-center gap-1">
          <CyberIcon name="wrench" class="size-3 text-mint" /> อุปกรณ์ที่ต้องใช้:
        </span>
        <strong class="text-white text-xs block mt-0.5" id="stageTool">{initialStep.tool}</strong>
      </div>

      <div class="p-3 rounded-xl bg-paper border border-line">
        <span class="text-textMuted text-[10px] block flex items-center gap-1">
          <CyberIcon name="clock" class="size-3 text-amber-400" /> เวลาต่อรอบ:
        </span>
        <strong class="text-amber-300 text-xs block mt-0.5" id="stageDuration">{initialStep.duration}</strong>
      </div>

      <div class="p-3 rounded-xl bg-paper border border-line">
        <span class="text-textMuted text-[10px] block flex items-center gap-1">
          <CyberIcon name="scale" class="size-3 text-cyan-300" /> น้ำหนักของ:
        </span>
        <strong class="text-cyan-300 text-xs block mt-0.5" id="stageWeight">{initialStep.weight}</strong>
      </div>

      <div class="p-3 rounded-xl bg-paper border border-line">
        <span class="text-textMuted text-[10px] block flex items-center gap-1">
          <CyberIcon name="trending-up" class="size-3 text-lime" /> ผลลัพธ์ที่ได้:
        </span>
        <strong class="text-lime text-xs block mt-0.5" id="stageOutput">{initialStep.output}</strong>
      </div>
    </div>

    <!-- Map & Location Showcase (Dual Action Cards) -->
    <div class="space-y-3">
      <div class="flex items-center justify-between text-xs font-mono text-textMuted">
        <span class="flex items-center gap-1.5 text-white font-bold">
          <CyberIcon name="map" class="size-4 text-mint" />
          <span>ภาพถ่ายหน้างานจริง & เรดาร์ GPS ในเมือง RUN TOWN</span>
        </span>
        <span class="text-[11px] text-mint">แตะที่ภาพเพื่อซูมขยาย</span>
      </div>

      <div class="relative rounded-2xl border border-line overflow-hidden bg-slate-950 shadow-lg group">
        <div class="aspect-[16/8] sm:aspect-[21/9] w-full overflow-hidden bg-black/70 flex items-center justify-center relative">
          <img
            id="stageImage"
            src={initialStep.image}
            alt={initialStep.name}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 cursor-pointer"
            data-lightbox-trigger
            data-lightbox-src={initialStep.image}
            data-lightbox-title={initialStep.name}
            data-lightbox-coords={initialStep.coords}
            data-lightbox-spot={initialStep.spotId}
          />

          <!-- Hover Overlay Action Buttons -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity flex items-end justify-between p-4 font-mono text-xs pointer-events-none">
            <span class="text-white text-xs font-bold drop-shadow flex items-center gap-1.5">
              <CyberIcon name="map-pin" class="size-3.5 text-mint" />
              <span>โซนที่ตั้ง:</span>
              <span id="overlayCoords" class="text-mint">{initialStep.coords}</span>
            </span>

            <div class="flex items-center gap-2 pointer-events-auto">
              <button
                type="button"
                id="stageZoomBtn"
                class="px-3 py-1.5 rounded-lg border border-white/20 bg-black/70 text-white hover:border-mint hover:text-mint backdrop-blur-md transition-all flex items-center gap-1.5 shadow"
              >
                <CyberIcon name="search" class="size-3.5" />
                <span>ซูมภาพ Lightbox</span>
              </button>

              <a
                id="stageLiveMapLink"
                href={`/map?spot=${encodeURIComponent(initialStep.spotId)}`}
                class="px-3 py-1.5 rounded-lg border border-mint/40 bg-mint/20 text-mint hover:bg-mint/30 backdrop-blur-md transition-all flex items-center gap-1.5 font-bold shadow"
              >
                <CyberIcon name="map" class="size-3.5" />
                <span>เปิดบน Live Map ➔</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

</section>

<script>
  function initJobStepper() {
    const jobs = {
      wood: {
        name: 'งานตัดไม้',
        steps: [
