---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import BrainFatigueMeter from '../components/BrainFatigueMeter.astro';
import FoodHungerMeter from '../components/FoodHungerMeter.astro';
import ItemGallery from '../components/ItemGallery.astro';
import BentoJobsGrid from '../components/BentoJobsGrid.astro';
import SafeHubs from '../components/SafeHubs.astro';
import ProfitCalculator from '../components/ProfitCalculator.astro';
import VehicleShowroom from '../components/VehicleShowroom.astro';
import CraftingTree from '../components/CraftingTree.astro';
import CrimeDirectory from '../components/CrimeDirectory.astro';
import EventRadar from '../components/EventRadar.astro';
import CyberIcon from '../components/CyberIcon.astro';
import GuideIcon from '../components/GuideIcon.astro';
import { getCleanTitle } from '../utils/guideHelpers';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
allGuides.sort((a, b) => a.data.order - b.data.order);

const whiteJobGuides = allGuides.filter(g => g.data.category === 'white_jobs');
const blackJobGuides = allGuides.filter(g => g.data.category === 'black_jobs');
const vehicleGuides = allGuides.filter(g => g.data.category === 'vehicles');
const craftingGuides = allGuides.filter(g => g.data.category === 'crafting');
const survivalGuides = allGuides.filter(g => g.data.category === 'survival');
const foodGuides = allGuides.filter(g => g.data.category === 'food');
const gangGuides = allGuides.filter(g => g.data.category === 'gang');
---

<BaseLayout title="RUN TOWN ✦ FiveM Wiki Hub" activeCategory="home">
  
  <!-- Top Marquee Stat Ticker -->
  <MarqueeTicker />

  <!-- Hero Section: Welcoming New Player Hub (Cocodly Layout) -->
  <section class="relative isolate overflow-hidden border-b border-line">
    <img
      src="/images/hero-city.png"
      alt="RUN TOWN FiveM City Skyline"
      class="absolute inset-0 w-full h-full object-cover opacity-45 -z-20 pointer-events-none"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#050b08]/60 via-[#050b08]/80 to-[#050b08] -z-10 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid opacity-60 [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)] -z-10 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-40 left-1/2 -z-10 size-[600px] -translate-x-1/2 rounded-full bg-mint/15 blur-[120px] pointer-events-none" aria-hidden="true"></div>

    <div class="mx-auto flex max-w-7xl flex-col items-start px-4 pb-20 pt-16 sm:px-6 md:pb-24 md:pt-20">
      <p class="inline-flex items-center gap-2 rounded-full border border-mint/30 bg-mint/10 px-3.5 py-1.5 text-xs text-mint backdrop-blur-md sm:text-sm">
        <CyberIcon name="shield-check" class="size-4 shrink-0 text-mint" />
        <span>คู่มือเอาชีวิตรอด & เริ่มต้นตั้งตัว</span>
        <span class="text-mint/50" aria-hidden="true">|</span>
        <span class="font-mono text-xs tracking-wider">RUN TOWN FIVEM</span>
      </p>

      <h1 class="mt-6 max-w-4xl text-balance text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight text-white tracking-tight">
        ยินดีต้อนรับสู่ <span class="text-mint drop-shadow-[0_0_25px_rgba(69,242,180,0.45)]">RUN TOWN</span>
        <span class="block text-2xl sm:text-3xl md:text-4xl font-normal text-slate-300 mt-2">
          ศูนย์ข้อมูล & คู่มือสำหรับผู้เล่นใหม่
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-pretty text-base sm:text-lg leading-relaxed text-slate-300 font-normal">
        ไม่เคยเล่น FiveM หรือเพิ่งเข้าเมืองครั้งแรก? เรียนรู้กฎความปลอดภัย แหล่งทำเงินสร้างตัวที่ไวที่สุด
        และวิธีเอาชีวิตรอดไม่ให้สลบกลางทาง
      </p>

      <!-- 3 Primary Newbie Call to Actions -->
      <div class="mt-10 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap items-stretch sm:items-center">
        <a
          href="#survival-rules"
          class="group inline-flex items-center justify-center gap-2.5 rounded-xl bg-mint px-6 py-3.5 text-sm font-extrabold text-slate-950 transition-all hover:bg-lime hover:shadow-[0_0_32px_-4px_rgba(165,255,95,0.6)]"
        >
          <CyberIcon name="shield-check" class="size-4 text-slate-950" />
          <span>อ่าน 4 กฎเอาชีวิตรอด</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>
        <a
          href="/map"
          class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-mint/50 bg-mint/5 px-6 py-3.5 text-sm font-bold text-mint backdrop-blur-md transition-all hover:bg-mint/15 hover:shadow-[0_0_20px_rgba(69,242,180,0.3)]"
        >
          <CyberIcon name="map" class="size-4 text-mint" />
          <span>เปิดแผนที่พิกัด Live Map</span>
        </a>
        <a
          href="/guides/jobs/white"
          class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-line bg-card/60 px-6 py-3.5 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/5 hover:text-mint hover:border-mint/40"
        >
          <CyberIcon name="briefcase" class="size-4 text-slate-400 group-hover:text-mint" />
          <span>ดูกระดาน 8 งานขาว</span>
        </a>
        <a
          href="/guides/gang/headquarter"
          class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-amber-400/60 bg-gradient-to-r from-amber-500/20 via-amber-400/15 to-transparent px-6 py-3.5 text-sm font-extrabold text-amber-300 backdrop-blur-md transition-all hover:bg-amber-400/25 hover:shadow-[0_0_24px_rgba(245,158,11,0.4)] hover:scale-102"
        >
          <img src="/items/icons/transparent/hq_coin.png" class="size-5 object-contain shrink-0" alt="HQ Coin" />
          <span>ระบบแก๊ง Headquarter</span>
          <span class="rounded bg-amber-400/30 px-1.5 py-0.5 text-[10px] font-mono text-amber-200 uppercase font-bold">NEW</span>
          <span>➔</span>
        </a>
      </div>

      <!-- Server Live Stats Row (Cocodly Telemetry Architecture) -->
      <dl class="mt-14 grid w-full max-w-3xl grid-cols-2 sm:grid-cols-4 gap-px overflow-hidden rounded-xl border border-line bg-line shadow-sm">
        <div class="bg-card/90 px-5 py-4 backdrop-blur-md">
          <dt class="text-xs text-slate-400 font-mono">ผู้เล่นออนไลน์</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-mint">300+</dd>
        </div>
        <div class="bg-card/90 px-5 py-4 backdrop-blur-md">
          <dt class="text-xs text-slate-400 font-mono">งานขาว</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-lime">8</dd>
        </div>
        <div class="bg-card/90 px-5 py-4 backdrop-blur-md">
          <dt class="text-xs text-slate-400 font-mono">Safe Zones</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-cyan-300">4</dd>
        </div>
        <div class="bg-card/90 px-5 py-4 backdrop-blur-md">
          <dt class="text-xs text-slate-400 font-mono">Uptime</dt>
          <dd class="mt-1 font-mono text-2xl font-bold text-amber-300">99.9%</dd>
        </div>
      </dl>

      <!-- 6 Core Category Shortcuts Row -->
      <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-xs max-w-4xl">
        <a href="/guides/jobs/white" class="cyber-tilt-card px-3.5 py-2 rounded-xl border border-mint/30 bg-card hover:border-mint transition-colors text-left flex items-center gap-2">
          <CyberIcon name="briefcase" class="size-3.5 text-mint" />
          <span class="text-slate-300 text-xs font-semibold">งานขาว (8)</span>
        </a>
        <a href="/guides/jobs/black" class="cyber-tilt-card px-3.5 py-2 rounded-xl border border-danger/40 bg-card hover:border-danger transition-colors text-left flex items-center gap-2">
          <CyberIcon name="skull" class="size-3.5 text-danger" />
          <span class="text-slate-300 text-xs font-semibold">งานดำ (4)</span>
        </a>
        <a href="/guides/logistics/vehicles" class="cyber-tilt-card px-3.5 py-2 rounded-xl border border-amber-400/40 bg-card hover:border-amber-400 transition-colors text-left flex items-center gap-2">
          <CyberIcon name="truck" class="size-3.5 text-amber-400" />
          <span class="text-slate-300 text-xs font-semibold">ยานพาหนะ</span>
        </a>
        <a href="/guides/crafting/weapons" class="cyber-tilt-card px-3.5 py-2 rounded-xl border border-lime/30 bg-card hover:border-lime transition-colors text-left flex items-center gap-2">
          <CyberIcon name="swords" class="size-3.5 text-lime" />
          <span class="text-slate-300 text-xs font-semibold">คราฟต์อาวุธ</span>
        </a>
        <a href="/guides/survival/vitals" class="cyber-tilt-card px-3.5 py-2 rounded-xl border border-purple-400/30 bg-card hover:border-purple-400 transition-colors text-left flex items-center gap-2">
          <CyberIcon name="brain" class="size-3.5 text-purple-300" />
          <span class="text-slate-300 text-xs font-semibold">ค่าสมอง</span>
        </a>
        <a href="/guides/food/nutrition" class="cyber-tilt-card px-3.5 py-2 rounded-xl border border-mint/30 bg-card hover:border-mint transition-colors text-left flex items-center gap-2">
          <CyberIcon name="drumstick" class="size-3.5 text-mint" />
          <span class="text-slate-300 text-xs font-semibold">อาหาร</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 1: 4 Golden Survival Rules for Newbies -->
  <section id="survival-rules" class="max-w-[1280px] mx-auto px-4 sm:px-6 py-12 space-y-8 scroll-mt-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 pb-4 border-b border-line">
      <div>
        <span class="text-xs font-mono font-bold text-mint uppercase tracking-wider">// NEW PLAYER SURVIVAL GUIDE</span>
        <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-white mt-1 flex items-center gap-2">
          <CyberIcon name="shield-check" class="size-7 text-mint" />
          <span>4 สิ่งที่ต้องเข้าใจทันทีเมื่อก้าวเข้าเมือง RUN TOWN</span>
        </h2>
      </div>
      <p class="text-xs sm:text-sm font-mono text-slate-300 max-w-md">
        เข้าใจระบบพื้นฐาน 4 ข้อนี้ จะช่วยให้คุณไม่สลบเป็นลมกลางทาง และสร้างตัวได้เร็วขึ้น 10 เท่า
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Rule 1: Hunger -->
      <div class="cyber-tilt-card p-6 rounded-2xl border border-rose-500/40 bg-card hover:border-rose-400 transition-all shadow-neon-card space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <CyberIcon name="drumstick" box={true} tone="rose" class="size-6" />
            <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 font-bold">
              ความหิว (ห้ามแตะ 100%)
            </span>
          </div>
          <h3 class="text-lg font-display font-extrabold text-white">
            1. หลอดอาหาร (ระบบความหิว)
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            ตัวละครจะมีความหิวสะสมตลอดเวลา หากหลอดอาหารพุ่งแตะ <strong class="text-rose-400 font-bold">100%</strong> ตัวละครจะสลบ หรือ เสียชีวิต ต้องรอมีคนมาชุบ หรือเรียกหมอมาชุบ หรือเกิดโรงพยาบาล
          </p>

          <!-- Telemetry Meter -->
          <div class="space-y-1.5 p-3 rounded-xl bg-slate-950/70 border border-line">
            <div class="flex items-baseline justify-between text-xs font-mono">
              <span class="text-slate-400">ระดับความหิวสะสม:</span>
              <span class="text-rose-400 font-bold text-base">100% <span class="text-xs text-rose-300 font-normal">= สลบ / เสียชีวิตทันที</span></span>
            </div>
            <div class="h-2 rounded-full bg-slate-900 border border-line overflow-hidden">
              <div class="h-full w-[95%] rounded-full bg-gradient-to-r from-mint via-amber-400 to-rose-500"></div>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/80 border border-line text-xs space-y-2 text-slate-200">
            <p class="font-bold text-rose-300 flex items-center gap-1.5">
              <CyberIcon name="lightbulb" class="size-4 text-amber-300" />
              <span>คำแนะนำสำหรับมือใหม่:</span>
            </p>
            <ul class="space-y-1.5 text-textMuted font-sans">
              <li class="flex items-start gap-2">
                <span class="font-mono text-mint font-bold shrink-0">•</span>
                <span>แวะร้านค้าเพื่อซื้อแซนวิชตามร้าน</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-mono text-mint font-bold shrink-0">•</span>
                <span>หรือเดินทางไปที่จุดรีหัวตามบาร์หรืออู่ช่าง</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="pt-3 border-t border-lineSubtle">
          <a href="/guides/food/nutrition" class="text-xs font-mono font-bold text-rose-300 hover:text-rose-200 flex items-center justify-between">
            <span>ดูตารางอาหาร & เสบียง</span>
            <span>➔</span>
          </a>
        </div>
      </div>

      <!-- Rule 2: Brain Fatigue -->
      <div class="cyber-tilt-card p-6 rounded-2xl border border-purple-500/40 bg-card hover:border-purple-400 transition-all shadow-neon-card space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <CyberIcon name="brain" box={true} tone="amber" class="size-6" />
            <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/40 font-bold">
              ความเหนื่อยล้า (ห้ามแตะ 100%)
            </span>
          </div>
          <h3 class="text-lg font-display font-extrabold text-white">
            2. หลอดสมอง & อาการล้า (หัวร้อน-หัวตึง)
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            ทุกครั้งที่ยืนฟาร์ม ตัดไม้ ขุดแร่ หรือยืนแปรรูปของ หลอดสมองจะสะสมความล้าเรื่อยๆ หากพุ่งแตะ <strong class="text-rose-400 font-bold">100%</strong> ตัวละครจะสลบ หรือ เสียชีวิต ต้องรอมีคนมาชุบ หรือเรียกหมอมาชุบ หรือเกิดโรงพยาบาล
          </p>

          <!-- Telemetry Meter -->
          <div class="space-y-1.5 p-3 rounded-xl bg-slate-950/70 border border-line">
            <div class="flex items-baseline justify-between text-xs font-mono">
              <span class="text-slate-400">สถานะสมองสะสม:</span>
              <span class="text-rose-400 font-bold text-base">100% <span class="text-xs text-rose-300 font-normal">= สลบ / เสียชีวิตทันที</span></span>
            </div>
            <div class="h-2 rounded-full bg-slate-900 border border-line overflow-hidden">
              <div class="h-full w-[95%] rounded-full bg-gradient-to-r from-mint via-amber-400 to-rose-500"></div>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/80 border border-line text-xs space-y-2 text-slate-200">
            <p class="font-bold text-purple-300 flex items-center gap-1.5">
              <CyberIcon name="lightbulb" class="size-4 text-amber-300" />
              <span>วิธีการแก้ปัญหา (มีแค่ 2 วิธีนี้เท่านั้น):</span>
            </p>
            <ul class="space-y-1.5 text-textMuted font-sans">
              <li class="flex items-start gap-2">
                <span class="font-mono text-mint font-bold shrink-0">1.</span>
                <span><strong class="text-white">ไปรีที่สถานที่ต่าง</strong> (เดินทางไปพักผ่อนตามจุดบริการต่างๆ ในเมือง)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-mono text-amber-300 font-bold shrink-0">2.</span>
                <span><strong class="text-white">ใช้ไอเทมช่วยรีหัว</strong> <span class="text-slate-400 font-mono text-[11px]">(ข้อมูลไอเทมจะอัปเดตเร็วๆ นี้)</span></span>
              </li>
            </ul>
          </div>
        </div>
        <div class="pt-3 border-t border-lineSubtle">
          <a href="/guides/survival/vitals" class="text-xs font-mono font-bold text-purple-300 hover:text-purple-200 flex items-center justify-between">
            <span>ดูกลไกหลอดสมอง & วิธีรีหัว</span>
            <span>➔</span>
          </a>
        </div>
      </div>

      <!-- Rule 3: Vehicle Payload -->
      <div class="cyber-tilt-card p-6 rounded-2xl border border-amber-400/40 bg-card hover:border-amber-300 transition-all shadow-neon-card space-y-4 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <CyberIcon name="truck" box={true} tone="mint" class="size-6" />
            <span class="text-[11px] font-mono px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/40 font-bold">
              หัวใจหลักการทำเงิน
            </span>
          </div>
          <h3 class="text-lg font-display font-extrabold text-white">
            3. ยานพาหนะ & ท้ายรถ (กุญแจสำคัญ ไม่ต้องเดินแบก)
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            กระเป๋าตัวละครเริ่มต้นรับได้แค่ <strong class="text-amber-300 font-bold">30 กก.</strong> (สามารถทำเควสเพื่ออัพเกรดเพิ่มได้) หากเดินเก็บของดิบแล้ววิ่งไปขายจะเสียเวลามาก <strong class="text-amber-300">การมีรถขนของคือจุดเปลี่ยนของชีวิตในเมือง!</strong>
          </p>

          <!-- Telemetry Meter -->
          <div class="space-y-2 p-3 rounded-xl bg-slate-950/70 border border-line text-xs font-mono">
            <div>
              <div class="flex items-baseline justify-between text-[11px]">
                <span class="text-slate-400">กระเป๋าตัวละคร (เริ่มต้น)</span>
                <span class="text-mint font-bold">30.0 กก. <span class="text-[10px] text-textMuted font-normal">(เควสอัพเกรดได้)</span></span>
              </div>
              <div class="h-1.5 rounded-full bg-slate-900 border border-line overflow-hidden mt-1">
                <div class="h-full w-[25%] rounded-full bg-mint"></div>
              </div>
            </div>
            <div>
              <div class="flex items-baseline justify-between text-[11px]">
                <span class="text-slate-400">รถกระบะขนของ (Logistics)</span>
                <span class="text-lime font-bold">120 - 150 กก.</span>
              </div>
              <div class="h-1.5 rounded-full bg-slate-900 border border-line overflow-hidden mt-1">
                <div class="h-full w-[100%] rounded-full bg-gradient-to-r from-mint to-lime"></div>
              </div>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/80 border border-line text-xs space-y-2 text-slate-200">
            <p class="font-bold text-amber-300 flex items-center gap-1.5">
              <CyberIcon name="lightbulb" class="size-4 text-amber-300" />
              <span>คำแนะนำสำหรับมือใหม่:</span>
            </p>
            <ul class="space-y-1.5 text-textMuted font-sans">
              <li class="flex items-start gap-2">
                <span class="font-mono text-amber-300 font-bold shrink-0">•</span>
                <span>มีรถโลเริ่มต้น <strong class="text-white">60 กก., 120 กก., 150 กก.</strong> ขับไปจอดเทียบจุดฟาร์มเพื่อขนของ</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-mono text-amber-300 font-bold shrink-0">•</span>
                <span>กระเป๋าตัวละครเริ่มต้นรับได้แค่ 30 กก. แต่สามารถทำเควสอัพเกรดได้ในภายหลัง</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-mono text-amber-300 font-bold shrink-0">•</span>
