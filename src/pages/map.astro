  // Create Marker Icon with GTA V styled pin & glowing badge
  function createCustomMarkerIcon(spot: any, isSelected: boolean) {
    const borderColor = spot.color || '#f59e0b';
    const svgIcon = GROUP_SVGS[spot.group] || GROUP_SVGS['pork'];
    return L.divIcon({
      className: 'gta-custom-div-icon',
      html: `
        <div class="gta-marker-container ${isSelected ? 'scale-115' : ''}">
          <div class="gta-marker-badge" style="background: rgba(15, 23, 42, 0.95); border-color: ${borderColor}; color: #ffffff;">
            <span style="display: inline-flex; align-items: center; color: ${borderColor};">${svgIcon}</span>
            <span style="color: #ffffff; font-weight: 600;">${spot.label}</span>
          </div>
          <div class="gta-marker-icon-box" style="background: #0f172a; border: 2px solid ${borderColor}; color: ${borderColor};">
            <div class="pulse-ring" style="border: 2px solid ${borderColor};"></div>
            <span style="display: inline-flex; align-items: center;">${svgIcon}</span>
          </div>
        </div>
      `,
      iconSize: [120, 60],
      iconAnchor: [60, 52]
    });
  }

  function renderMarkers() {
    if (!markersLayer) return;
    markersLayer.clearLayers();
    routesLayer.clearLayers();
    markerInstances = {};

    // 1. Plot Spots Matching Active Filter (Deduplicated by spot.id)
    const renderedIds = new Set<string>();
    Object.values(spotsData).forEach(spot => {
      if (renderedIds.has(spot.id)) return;
      renderedIds.add(spot.id);
      if (activeFilter !== 'all' && spot.group !== activeFilter) return;

      const latlng = gameCoordsToLatLng(spot.x, spot.y);
      const isSelected = spot.id === currentSelectedId;
      const marker = L.marker(latlng, {
        icon: createCustomMarkerIcon(spot, isSelected),
        riseOnHover: true
      });

      marker.on('click', () => {
        selectSpot(spot.id, true);
      });

      marker.addTo(markersLayer);
      markerInstances[spot.id] = marker;
    });

    // 2. Draw Realistic GPS Transport Routes Following Actual Roads
    if (activeFilter === 'all' || activeFilter === 'wood') {
      const woodPoints = (jobGpsRoadRoutes.wood || []).map((pt: any) => gameCoordsToLatLng(pt.x, pt.y));
      if (woodPoints.length > 0) {
        L.polyline(woodPoints, {
          color: '#000000',
          weight: 6,
          opacity: 0.75,
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
        L.polyline(woodPoints, {
          color: '#f59e0b',
          weight: 3.5,
          opacity: 0.95,
          dashArray: '8, 6',
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
      }
    }

    if (activeFilter === 'all' || activeFilter === 'pork') {
      const porkPoints = (jobGpsRoadRoutes.pork || []).map((pt: any) => gameCoordsToLatLng(pt.x, pt.y));
      if (porkPoints.length > 0) {
        L.polyline(porkPoints, {
          color: '#000000',
          weight: 6,
          opacity: 0.75,
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
        L.polyline(porkPoints, {
          color: '#ec4899',
          weight: 3.5,
          opacity: 0.95,
          dashArray: '8, 6',
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
      }
    }

    if (activeFilter === 'all' || activeFilter === 'wheat') {
      const wheatPoints = (jobGpsRoadRoutes.wheat || jobGpsRoadRoutes.agri || []).map((pt: any) => gameCoordsToLatLng(pt.x, pt.y));
      if (wheatPoints.length > 0) {
        L.polyline(wheatPoints, {
          color: '#000000',
          weight: 6,
          opacity: 0.75,
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
        L.polyline(wheatPoints, {
          color: '#eab308',
          weight: 3.5,
          opacity: 0.95,
          dashArray: '8, 6',
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
      }
    }

    if (activeFilter === 'all' || activeFilter === 'flower') {
      const flowerPoints = ((jobGpsRoadRoutes as any).flower || []).map((pt: any) => gameCoordsToLatLng(pt.x, pt.y));
      if (flowerPoints.length > 0) {
        L.polyline(flowerPoints, {
          color: '#000000',
          weight: 6,
          opacity: 0.75,
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
        L.polyline(flowerPoints, {
          color: '#f43f5e',
          weight: 3.5,
          opacity: 0.95,
          dashArray: '8, 6',
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
      }
    }

    if (activeFilter === 'all' || activeFilter === 'mine') {
      const minePoints = (jobGpsRoadRoutes.mine || []).map((pt: any) => gameCoordsToLatLng(pt.x, pt.y));
      if (minePoints.length > 0) {
        L.polyline(minePoints, {
          color: '#000000',
          weight: 6,
          opacity: 0.75,
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
        L.polyline(minePoints, {
          color: '#f97316',
          weight: 3.5,
          opacity: 0.95,
          dashArray: '8, 6',
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
      }
    }

    if (activeFilter === 'all' || activeFilter === 'crystal') {
      const crystalPoints = ((jobGpsRoadRoutes as any).crystal || []).map((pt: any) => gameCoordsToLatLng(pt.x, pt.y));
      if (crystalPoints.length > 0) {
        L.polyline(crystalPoints, {
          color: '#000000',
          weight: 6,
          opacity: 0.75,
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
        L.polyline(crystalPoints, {
          color: '#06b6d4',
          weight: 3.5,
          opacity: 0.95,
          dashArray: '8, 6',
          lineJoin: 'round',
          lineCap: 'round'
        }).addTo(routesLayer);
      }
    }

    if (activeFilter === 'all' || activeFilter === 'steel') {
      const rawSteel = (jobGpsRoadRoutes as any).steel || [];
      const steelLegs = (Array.isArray(rawSteel[0]) ? rawSteel : [rawSteel]).map((leg: any[]) =>
        leg.map((pt: any) => gameCoordsToLatLng(pt.x, pt.y))
      );

      steelLegs.forEach((steelPoints: L.LatLng[]) => {
        if (steelPoints.length > 0) {
          L.polyline(steelPoints, {
            color: '#000000',
            weight: 6,
            opacity: 0.75,
            lineJoin: 'round',
            lineCap: 'round'
          }).addTo(routesLayer);
          L.polyline(steelPoints, {
            color: '#94a3b8',
            weight: 3.5,
            opacity: 0.95,
            dashArray: '8, 6',
            lineJoin: 'round',
            lineCap: 'round'
          }).addTo(routesLayer);
        }
      });
    }
  }

  function selectSpot(id: string, flyTo: boolean = false) {
    const data = spotsData[id];
    if (!data) return;
    currentSelectedId = id;

    const titleEl = document.getElementById('mapPoiTitle');
    const descEl = document.getElementById('mapPoiDesc');
    const coordsEl = document.getElementById('mapPoiCoords');
    const badgeEl = document.getElementById('mapStatusBadge');
    const zoneEl = document.getElementById('mapPoiZone');

    if (titleEl) titleEl.textContent = data.title;
    if (descEl) descEl.textContent = data.desc;
    if (coordsEl) coordsEl.textContent = data.coords;
    if (zoneEl) zoneEl.textContent = data.zone || `${data.title.split(' ')[1] || data.label} · COOLDOWN: ${data.cdMinutes || 0} MIN · สุจริต 100%`;
    if (badgeEl) {
      badgeEl.textContent = data.status;
      badgeEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded-full border ' + data.statusClass;
    }

    // Refresh marker icons to reflect selection
    renderMarkers();

    // Smooth flyTo in Leaflet
    if (flyTo && mapInstance) {
      const targetLatLng = gameCoordsToLatLng(data.x, data.y);
      mapInstance.flyTo(targetLatLng, 5, { duration: 1.2 });
    }

    updateUI();
  }

  function updateUI() {
    const now = Date.now();
    const data = spotsData[currentSelectedId];
    const cd = activeCooldowns[currentSelectedId];

    const remEl = document.getElementById('spotCooldownRemaining');
    const progEl = document.getElementById('spotCooldownProgress');
    const statEl = document.getElementById('spotCooldownStatus');
    const btnText = document.getElementById('startCooldownBtnText');
    const startBtn = document.getElementById('startCooldownBtn') as HTMLButtonElement;

    if (!data || data.cdMinutes === 0) {
      if (remEl) remEl.textContent = '--:--';
      if (progEl) progEl.style.width = '100%';
      if (statEl) statEl.textContent = 'สถานะ: ไม่มีคูลดาวน์';
      if (btnText) btnText.textContent = 'ไม่มีคูลดาวน์';
      if (startBtn) startBtn.disabled = true;
    } else if (cd && cd.expiresAt > now) {
      const remainingSec = Math.max(0, Math.ceil((cd.expiresAt - now) / 1000));
      const totalSec = cd.duration || 600;
      const pct = Math.min(100, Math.round(((totalSec - remainingSec) / totalSec) * 100));

      if (remEl) remEl.textContent = formatTime(remainingSec);
      if (progEl) progEl.style.width = pct + '%';
      if (statEl) statEl.textContent = `สถานะ: กำลังคูลดาวน์ (${pct}%)`;
      if (btnText) btnText.textContent = 'ยกเลิกคูลดาวน์';
      if (startBtn) startBtn.disabled = false;
    } else {
      if (remEl) remEl.textContent = '10:00';
      if (progEl) progEl.style.width = '100%';
      if (statEl) statEl.textContent = 'สถานะ: พร้อมกดฟาร์ม';
      if (btnText) btnText.textContent = 'เริ่มคูลดาวน์ (10:00)';
      if (startBtn) startBtn.disabled = false;
    }

    renderTray();
  }

  function renderTray() {
    const now = Date.now();
    const activeKeys = Object.keys(activeCooldowns).filter(k => activeCooldowns[k].expiresAt > now);
    const countEl = document.getElementById('activeCdCount');
    const listEl = document.getElementById('activeCdList');
    if (countEl) countEl.textContent = String(activeKeys.length);

    if (!listEl) return;
    if (activeKeys.length === 0) {
      listEl.innerHTML = '<div class="text-[11px] text-textMuted italic py-1 text-center">ไม่มีจุดที่ติดคูลดาวน์</div>';
      return;
    }

    listEl.innerHTML = activeKeys.map(k => {
      const remaining = Math.max(0, Math.ceil((activeCooldowns[k].expiresAt - now) / 1000));
      const loc = spotsData[k] || { title: k };
      return `
        <div class="flex items-center justify-between p-2 rounded-lg border border-line bg-base text-xs font-mono">
          <span class="text-white truncate cursor-pointer hover:text-mint" onclick="window.selectSpot('${k}', true)">${loc.title.split(' ')[0]} ${loc.title.split(' ')[1] || ''}</span>
          <span class="text-amber-400 font-bold">${formatTime(remaining)}</span>
        </div>
      `;
    }).join('');
  }

  // Set Layer Tile
  function switchLayer(layerKey: keyof typeof TILE_LAYERS) {
    const config = TILE_LAYERS[layerKey];
    if (!config || !mapInstance) return;

    if (currentTileLayer) {
      mapInstance.removeLayer(currentTileLayer);
    }

    mapInstance.getContainer().style.backgroundColor = config.bgColor;
    currentTileLayer = L.tileLayer(config.url, {
      noWrap: true,
      minZoom: 1,
      maxZoom: 10,
      maxNativeZoom: 7,
      bounds: MAP_BOUNDS,
      className: config.className
    });
    currentTileLayer.addTo(mapInstance);
  }

  // Initialize Real Leaflet GTA V Map
  const mapContainer = document.getElementById('leafletMap');
  if (mapContainer) {
    const initialCenter = gameCoordsToLatLng(spotsData['wood-farm'].x, spotsData['wood-farm'].y);

    mapInstance = L.map(mapContainer, {
      crs: L.CRS.Simple,
      minZoom: 1,
      maxZoom: 10,
      zoom: 3,
      center: initialCenter,
      maxBounds: MAP_MAX_BOUNDS,
      maxBoundsViscosity: 0.8,
      attributionControl: false,
      zoomControl: false
    });

    L.control.zoom({ position: 'bottomright' }).addTo(mapInstance);

    // Initial Layer: Game Radar (เรดาร์)
    switchLayer('game');

    // Groups
    routesLayer = L.layerGroup().addTo(mapInstance);
    markersLayer = L.layerGroup().addTo(mapInstance);

    // Initial Markers
    renderMarkers();

    // Auto-select from URL search parameters ?spot=...
    const urlParams = new URLSearchParams(window.location.search);
    const targetSpot = urlParams.get('spot');
    if (targetSpot && spotsData[targetSpot]) {
      const spotGroup = spotsData[targetSpot].group;
      activeFilter = spotGroup;

      document.querySelectorAll('.map-filter-btn').forEach(btn => {
        const filter = btn.getAttribute('data-filter');
        if (filter === spotGroup) {
          btn.classList.remove('border-line', 'bg-paper', 'text-textSoft');
          btn.classList.add('border-mint', 'bg-mint/20', 'text-mint', 'font-bold', 'active');
        } else {
          btn.classList.remove('border-mint', 'bg-mint/20', 'text-mint', 'font-bold', 'active');
          btn.classList.add('border-line', 'bg-paper', 'text-textSoft');
        }
      });

      renderMarkers();
      selectSpot(targetSpot, true);
    } else {
      selectSpot('wood-farm', true);
    }
  }

  // Layer buttons
  document.querySelectorAll('.layer-switch-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.layer-switch-btn').forEach(b => {
        b.classList.remove('text-mint', 'font-bold', 'bg-mint/15', 'active');
        b.classList.add('text-textSoft');
      });
      btn.classList.remove('text-textSoft');
      btn.classList.add('text-mint', 'font-bold', 'bg-mint/15', 'active');

      const layer = btn.getAttribute('data-layer') as keyof typeof TILE_LAYERS;
      if (layer) switchLayer(layer);
    });
  });

  // Filter Buttons
  document.querySelectorAll('.map-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.map-filter-btn').forEach(b => {
        b.classList.remove('border-mint', 'bg-mint/20', 'text-mint', 'font-bold', 'active');
        b.classList.add('border-line', 'bg-paper', 'text-textSoft');
      });
      btn.classList.remove('border-line', 'bg-paper', 'text-textSoft');
      btn.classList.add('border-mint', 'bg-mint/20', 'text-mint', 'font-bold', 'active');

      activeFilter = btn.getAttribute('data-filter') || 'all';
      renderMarkers();

      // If active filter has spots, fly to first
      const firstMatching = Object.values(spotsData).find(s => activeFilter === 'all' || s.group === activeFilter);
      if (firstMatching) {
        selectSpot(firstMatching.id, true);
      }
    });
  });

  // Cooldown Controls
  const startBtn = document.getElementById('startCooldownBtn');
  if (startBtn) {
    startBtn.addEventListener('click', () => {
      const now = Date.now();
      const cd = activeCooldowns[currentSelectedId];
      if (cd && cd.expiresAt > now) {
        delete activeCooldowns[currentSelectedId];
      } else {
        activeCooldowns[currentSelectedId] = {
          expiresAt: now + 600000,
          duration: 600,
          notified: false
        };
      }
      saveCooldowns();
      updateUI();
    });
  }

  const resetBtn = document.getElementById('resetCooldownBtn');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      delete activeCooldowns[currentSelectedId];
      saveCooldowns();
      updateUI();
    });
  }

  const copyBtn = document.getElementById('copyGpsBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const loc = spotsData[currentSelectedId];
      if (loc) {
        navigator.clipboard.writeText(loc.coords).then(() => {
          alert('คัดลอกพิกัด GPS: ' + loc.coords);
        });
      }
    });
  }

  const toggleSoundBtn = document.getElementById('toggleSoundBtn');
  if (toggleSoundBtn) {
    toggleSoundBtn.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      toggleSoundBtn.textContent = soundEnabled ? 'เสียงเตือน (เปิด)' : 'เสียงเตือน (ปิด)';
    });
  }

  setInterval(() => {
    const now = Date.now();
    let changed = false;
    Object.keys(activeCooldowns).forEach(k => {
      const cd = activeCooldowns[k];
      if (cd && cd.expiresAt <= now && !cd.notified) {
        cd.notified = true;
        changed = true;
        playChime();
        alert(`${spotsData[k]?.title || k}: คูลดาวน์ 10 นาทีครบแล้ว!`);
      }
    });
    if (changed) saveCooldowns();
    updateUI();
  }, 1000);

  (window as any).selectSpot = selectSpot;
</script>
